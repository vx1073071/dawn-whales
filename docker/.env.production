# ═══════════════════════════════════════════════════════════════════
# DAWN WHALES v2.1.0 — Production Deployment Config (R136 J03)
# 
# SSL + Domain + Firewall + Security hardening
# 
# Usage:
#   1. Copy .env.example to .env and fill in values
#   2. Place SSL certs in ./ssl/
#   3. Run: docker compose up -d
# ═══════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=4096
HOST=0.0.0.0

# ── Domain & SSL ───────────────────────────────────────────────
DOMAIN=dawnwhales.app
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ── Security ───────────────────────────────────────────────────
JWT_SECRET=<generate-with-openssl-rand-hex-64>
JWT_EXPIRY=24h
CORS_ORIGIN=https://dawnwhales.app
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ── Database ───────────────────────────────────────────────────
DB_PATH=/data/dawn-whales.db
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL=86400000

# ── Broker API Keys ────────────────────────────────────────────
# Format: brokerId:apiKey:secretKey;...
BROKER_API_KEYS=

# Futu OpenD (desktop client connection)
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_OPEND_ENCRYPTION=true

# ── WebSocket ──────────────────────────────────────────────────
WS_PORT=4096
WS_PING_INTERVAL=30000
WS_MAX_CONNECTIONS=1000

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=/app/logs/dawn-whales.log
LOG_MAX_SIZE=50m
LOG_MAX_FILES=5

# ── Monitoring ─────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# ── Performance ────────────────────────────────────────────────
CACHE_TTL=60000
MAX_CONCURRENT_ORDERS=50
COPY_TRADE_MAX_USERS=100

# ═══════════════════════════════════════════════════════════════════
# FIREWALL RULES (iptables / nft)
# 
# On the host, apply:
# 
#   # Allow HTTP/HTTPS
#   iptables -A INPUT -p tcp --dport 80 -j ACCEPT
#   iptables -A INPUT -p tcp --dport 443 -j ACCEPT
#
#   # Allow API port (if not behind nginx)
#   iptables -A INPUT -p tcp --dport 4096 -s 127.0.0.1 -j ACCEPT
#
#   # Block all other inbound
#   iptables -A INPUT -j DROP
#
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# SSL Certificate Setup (Let's Encrypt)
#
#   certbot certonly --standalone -d dawnwhales.app
#   cp /etc/letsencrypt/live/dawnwhales.app/fullchain.pem ./ssl/
#   cp /etc/letsencrypt/live/dawnwhales.app/privkey.pem ./ssl/
#   chmod 600 ./ssl/privkey.pem
#
# ═══════════════════════════════════════════════════════════════════
