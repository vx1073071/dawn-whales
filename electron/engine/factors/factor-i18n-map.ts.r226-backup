    { factorId: 'CRYPTO_BRIDGE_FLOW', level: 'L3', nameCN: '跨链桥流量', categoryCN: '加密', region: 'crypto', oneLine: 'ETH/L2跨链桥TVL+净流量——"资金在哪条链上"', descriptionCN: '主要跨链桥(Arbitrum/Optimism/Polygon/Base)的TVL周环比+净流入/流出ETH的Z-score。正=资金流入L2(看好L2生态)→利好L2代币+ETH(因为ETH是L2Gas费)。', highMeaning: '资金涌入L2——L2生态繁荣', lowMeaning: '资金撤离L2——回归主网避险', story: '🌉 加密的"资金迁徙"——牛市时资金从ETH主网流入L2(Arbitrum/Optimism)追求高收益，熊市时资金回流主网避险。桥流量追踪的是"钱往哪走"——L2净流入持续为正=山寨季前兆。', signaldesc: '>2=强流入L2；0-2=温和；<0=流出', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
