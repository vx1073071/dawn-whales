    { factorId: 'CRYPTO_MINER_FLOW', level: 'L3', nameCN: '矿工抛压', categoryCN: '加密', region: 'crypto', oneLine: '矿工钱包→交易所的BTC转账量——"矿工在卖吗"', descriptionCN: '矿工地址→交易所地址的BTC净转账量/矿工日均收入的Z-score。>2=矿工大量转币到交易所(准备卖出→抛压)。<0=矿工囤币(看涨信号)。矿工是BTC"天然多头"——他们最了解挖矿成本，他们的行为是最好的"内部人"信号。', highMeaning: '矿工在大量卖币——抛压', lowMeaning: '矿工在囤币——看涨', story: '⛏️ 矿工每天被迫卖币付电费——但如果他们把"超过电费"的BTC也转到交易所=他们在主动抛售(看空)。反之矿工减少卖币甚至囤币=他们认为当前价格太低不值得卖。矿工是BTC的"内部人"——他们最懂生产成本。', signaldesc: '>2=矿工抛售(利空)；0-2=正常；<0=矿工囤币(看涨)', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_cloud' },
    { factorId: 'CRYPTO_ONCHAIN_GDP', level: 'L3', nameCN: '链上GDP', categoryCN: '加密', region: 'crypto', oneLine: '公链的"GDP"——日总交易费+MEV+质押收益的增速', descriptionCN: '(日交易费+MEV+质押收益)/总市值的年化率(链上GDP比率)，类比"经济体GDP增速"。>5%=链上经济活动繁荣(链的"经济"在高速增长→基本面强劲)。<1%=链上经济萎缩。适用于ETH/SOL/AVAX等有生态的公链。', highMeaning: '链上经济繁荣——"链的GDP"高速增长', lowMeaning: '链上经济萎缩——使用率下降', story: '🏭 一条公链就像一个"国家"——交易费=税收、MEV=金融市场活跃度、质押=储蓄率。链上GDP衡量的是这条链的"经济增速"。ETH的链上GDP>5%=DeFi/NFT/交易全线繁荣=ETH有强基本面支撑。', signaldesc: '>5%=繁荣；1-5%=温和；<1%=衰退', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'CRYPTO_MINER_SELL_PRESS', level: 'L3', nameCN: '矿工卖出压力指数', categoryCN: '加密', region: 'crypto', oneLine: '(矿工收入/矿工余额变化)——"矿工的抛售压力有几个标准差"', descriptionCN: '矿工30日挖矿总收入/(矿工地址30日BTC余额变化)的Z-score。>2=矿工收入远超囤币(大量抛售→强卖压)。<−1=矿工在囤币(收入大多未卖出)。与Puell配合使用效果更佳。', highMeaning: '矿工在大量卖出——抛售压力大', lowMeaning: '矿工在囤积——供给紧缩', story: '⚡ 矿工支出=电费+设备折旧。如果矿工挖的BTC全都卖掉还不够付电费(卖压指数>2)，他们必须抛售储备BTC→供应冲击→价格下跌。反之矿工囤币不卖=他们认为"现在太便宜"=供给紧缩。', signaldesc: '>2=强卖压；0-2=正常；<0=囤币', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_cloud' },
    { factorId: 'CRYPTO_CROSSCHAIN_FLOW', level: 'L3', nameCN: '跨链资金流', categoryCN: '加密', region: 'crypto', oneLine: 'ETH→SOL→AVAX→BNB等链间资金净流向——"热钱往哪涌"', descriptionCN: '多条公链间资金净流向矩阵的Z-score。ETH→SOL净流向>2=资金在从ETH迁移到Solana(SOL看涨)。ETH→BNB净流向<-1=资金从BSC回流ETH。揭示加密"内部轮动"——哪个链在"吸血"。', highMeaning: '该链在"吸血"其他链的资金', lowMeaning: '该链在"失血"', story: '🔄 加密市场内部也在"轮动"——有时Solana热(ETH→SOL资金流暴增)，有时BNB链热。跨链资金流告诉你"热钱现在在哪条链"——链的资金"争夺战"实时地图。', signaldesc: '>2=强流入；0-2=温和；<0=流出', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CRYPTO_RESERVE_PROOF', level: 'L3', nameCN: '交易所储备证明', categoryCN: '加密', region: 'crypto', oneLine: 'CEX钱包BTC/ETH余额27日变化——"交易所被挤兑了吗"', descriptionCN: '主要CEX(币安/Coinbase/OKX)公开钱包余额27日环比变化率。<-5%=大量提币(用户"搬砖"到冷钱包→交易所储备下降→挤兑风险→恐慌)。>+5%=存入增多(抛售意图)。FTX事件后此因子重要性大幅提升。', highMeaning: '交易所余额骤降——大规模提币(恐慌/囤币)', lowMeaning: '交易所余额增加——存入增多(抛售意愿)', story: '🏦 FTX倒闭后，加密世界不再"信任"交易所——每隔几个月就有"Proof of Reserve"恐慌。如果交易所BTC余额骤降5%+——不是"囤币"就是"恐慌提款"。这是加密市场的"银行挤兑指数"。', signaldesc: '<-5%=大规模提币(警惕)；-5%到5%=正常；>+5%=存入增多', colors: { greenMax: 40, yellowMax: 60, redMin: 61 }, direction: 'contextDependent', source: 'factor_cloud' },
    { factorId: 'CRYPTO_WHALE_TX_COUNT', level: 'L3', nameCN: '巨鲸交易笔数', categoryCN: '加密', region: 'crypto', oneLine: '>$1M链上转账笔数30日变化——"大户在行动吗"', descriptionCN: '$100万+链上转账日笔数30日均值的Z-score。>2=大户转账极度活跃(大资金在布局/挪仓→即将有行情)。<−1=大户休眠(市场平淡)。巨鲸转账是大行情的前导指标——他们通常较散户"提前"1-2周行动。数据：Whale Alert/Glassnode。', highMeaning: '巨鲸极度活跃——大资金在布局', lowMeaning: '巨鲸休眠——市场平淡', story: '🐋 BTC链上每笔>$100万的转账都有"大玩家"在操作——可能是机构建仓、交易所冷热钱包调拨、或巨鲸出货。巨鲸活跃度领先散户情绪1-2周——他们需要时间把大资金"分配"出去。', signaldesc: '>2=巨鲸极度活跃(行情前兆)；0-2=活跃；<0=休眠', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CRYPTO_25DELTA_RR', level: 'L3', nameCN: '25Delta风险逆转', categoryCN: '加密', region: 'crypto', oneLine: '25Delta Call IV-25Delta Put IV——"加密期权市场的偏度"', descriptionCN: 'BTC/ETH期权25Delta Call IV-25Delta Put IV的Z-score。正值>1=Call比Put贵(市场在追涨→贪婪信号)。负值<-1=Put比Call贵(市场在买保险→恐慌信号)。加密期权偏度比传统市场更敏感——因为参与者更情绪化。', highMeaning: '极度追涨——市场贪婪', lowMeaning: '极度恐慌——买保险', story: '📊 加密期权市场比股市更"情绪化"——25Delta风险逆转告诉你：CTA/对冲基金是在追Call(贪婪)还是在买Put(恐慌)。Deribit的期权数据是加密"聪明钱"最集中的体现。', signaldesc: '>1=贪婪(谨慎)；-1到1=中性；<-1=恐慌(逆向)', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'CRYPTO_OPTION_TERM', level: 'L3', nameCN: '加密期权期限结构', categoryCN: '加密', region: 'crypto', oneLine: 'BTC期权近端IV vs 远端IV——"短期vs长期恐慌"', descriptionCN: '(BTC 7日ATM IV - BTC 30日ATM IV)的Z-score。>2=近端IV远超远端(短期事件恐慌——可能有FOMC/CPI/升级等已知事件)。<-1=期限结构正常(短期平静)。加密期权期限结构比股市更陡峭——因为加密的事件驱动性更强。', highMeaning: '短期极度恐慌——有已知催化剂', lowMeaning: '期限结构正常——无短期事件', story: '📅 如果BTC期权的"本周保险"比"下月保险"贵很多——市场在为一个近期事件定价(美联储议息、ETF审批、升级)。加密的期限结构比美股更陡峭——因为加密大事更多、更频繁。', signaldesc: '>2=短期事件恐慌；0-2=温和；<0=正常', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'CRYPTO_DEV_CENTRAL', level: 'L3', nameCN: '开发者集中度', categoryCN: '加密', region: 'crypto', oneLine: '核心开发者集中度(前3贡献者/总)——"这个项目是去中心化还是一个人在扛"', descriptionCN: '前3代码贡献者占总提交的百分比。>70%=高度集中(关键人物风险——如果核心开发者离开=项目"死亡")。<30%=高度去中心化(社区驱动，安全)。配合开发者活跃度使用——高活跃+高集中=创始人驱动(高风险高回报)，低活跃+高集中=鬼城。', highMeaning: '去中心化开发——社区驱动', lowMeaning: '高度集中——关键人物风险', story: '👨‍💻 Bitcoin有数百名开发者——中本聪消失后依然运转。但如果一个DeFi项目的代码90%由一个人写的——这个人出车祸=项目归零。开发者集中度告诉你"这个项目是不是一个人的秀"。', signaldesc: '<30%=去中心化(安全)；30-70%=正常；>70%=单点风险', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_cloud' },
    { factorId: 'CRYPTO_TOKEN_UNLOCK', level: 'L3', nameCN: '代币解锁压力', categoryCN: '加密', region: 'crypto', oneLine: '未来30天即将解锁的代币量/流通量——"卖方洪水即将来临"', descriptionCN: '未来30日将解锁的代币(VC解锁+团队解锁+社区激励)/当前流通量的百分比Z-score。>5%=大量解锁(卖方洪水→持有者将被严重稀释→价格承压)。<1%=解锁少(安全)。TokenUnlocks/CoinGecko数据。', highMeaning: '无大规模解锁——供给安全', lowMeaning: '大规模解锁在即——卖方洪水', story: '🔓 加密最恐怖的"定时炸弹"——代币解锁。种子轮VC的币锁了12个月→到期解锁→他们成本$0.01→市价$1→100倍利润→他们不卖你信吗？代币解锁="你知道有人马上要砸盘"。', signaldesc: '<1%=安全；1-5%=中等；>5%=解锁洪水(避险)', colors: { greenMax: 35, yellowMax: 60, redMin: 61 }, direction: 'lowerBetter', source: 'factor_cloud' },
    { factorId: 'CRYPTO_PROTOCOL_REV', level: 'L3', nameCN: '协议收入', categoryCN: '加密', region: 'crypto', oneLine: 'DeFi协议年化收入/流通市值——"加密版的市盈率"', descriptionCN: '(协议30日费用收入×12)/流通市值=年化收入率(加密版E/P)。>10%=协议收入丰厚(基本面强——类似高股息股票)。<1%=协议几乎无收入(纯"空气币"特征)。覆盖Uniswap/Aave/Maker等主流DeFi。DeFiLlama数据。', highMeaning: '协议收入强劲——有实际价值支撑', lowMeaning: '协议无收入——纯投机', story: '💼 DeFi协议的"利润"——Uniswap的交易费、Aave的借贷利差、Maker的稳定费。协议收入率=你持有这个代币能分享的"协议利润"。收入率>10%的DeFi是"印钞机"，收入率<1%的DeFi是"空壳"。', signaldesc: '>10%=高收入(价值)；3-10%=中等；<3%=低', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CRYPTO_PF_RATIO', level: 'L3', nameCN: 'PF比率', categoryCN: '加密', region: 'crypto', oneLine: '价格/费用比率——"每1元费用支撑多少市值"，加密版P/S', descriptionCN: '市值/(协议30日费用×12)。<10=每元费用支撑市值低(便宜——"赚1元费用只要付出10元市值")。>100=极度昂贵("画饼"特征)。ETH/SOL/UNI/AAVE等有收入协议适用。配合协议收入率使用——高收入率+低PF=价值洼地。', highMeaning: '低PF——费用支撑充分', lowMeaning: '高PF——估值脱离费用', story: '📐 PF比率是加密版的"市销率"(P/S)。如果一条公链每年产生10亿的费用收入但市值1000亿——PF=100(你付100元买每年1元的"收入")。而如果Uniswap年收入5亿市值25亿——PF=5(每5元买1元收入——便宜)。', signaldesc: '<15=费用支撑充足；15-50=合理；>50=昂贵', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_research' },
    { factorId: 'CRYPTO_GOVERNANCE', level: 'L3', nameCN: '治理活跃度', categoryCN: '加密', region: 'crypto', oneLine: 'DAO提案数+投票参与率——"这个社区还活着吗"', descriptionCN: '月DAO提案数×投票参与率×通过率的归一化评分(0-100)。>60=治理活跃(社区在积极运营→去中心化治理有效)。<20=治理僵尸(无人投票/提案→项目被核心团队单向控制)。Uniswap/Compound/AAVE等DAO适用。', highMeaning: 'DAO治理活跃——社区驱动', lowMeaning: '治理僵尸——核心团队独裁', story: '🗳️ DAO的"民主度"——如果一年只有3个提案且投票率<5%=名为DAO实则"独裁"。治理活跃度>60=真正的去中心化(社区在积极决策)——这是加密项目的"终极护城河"。', signaldesc: '>60=活跃DAO；20-60=正常；<20=僵尸DAO', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },

    // ── 🌏 跨市场专属 ⚡ (5) ──────────────────────────────────────────
    { factorId: 'XM_CO_SKEWNESS', level: 'L3', nameCN: '协偏度', categoryCN: '跨市场', region: 'global', oneLine: '个股对市场下行风险的"共偏度"——"市场跌时你跌得比别人惨吗"', descriptionCN: '个股收益与市场收益协偏度(Coskewness)的标准化值。负值=市场大跌时该股跌得更惨(下行风险高——不避险品种)。正值=市场大跌时该股相对抗跌甚至上涨(真正的对冲属性)。比Beta更进一步：Beta看"幅度"，协偏度看"非线性
下跌风险"。', highMeaning: '市场跌时该股抗跌——真正的对冲', lowMeaning: '市场跌时该股加倍跌——避险属性差', story: '🎢 Beta告诉你在平均情况下该股跟大盘的关系。但那75%的"平静日子"不重要——重要的是市场暴跌10%那天你跌了多少。协偏度看的正是："黑天鹅日"你跑得掉吗？两个Beta一样1.0的股票——市场暴跌时一个跌5%(协偏度好)、一个跌20%(协偏度差)。', signaldesc: '>0.5=优秀避险；0-0.5=一般；<0=差', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'XM_IDIO_VOL', level: 'L3', nameCN: '特质波动率', categoryCN: '跨市场', region: 'global', oneLine: '去系统性风险后的"纯个股"波动——"这只票自己能翻多大浪"', descriptionCN: 'CAPM残差波动率(剔除市场因素后的波动)的Z-score。>2=极度高特质波动(大量"独立"于大盘的股价运动→可能是有并购/诉讼/新产品等个股事件)。<−1=特质波动低(股价运动几乎完全由大盘驱动→纯Beta工具)。Ang et al.(2006)发现高特质波动反而低收益("特质波动率之谜")。', highMeaning: '个股事件驱动——独立运动', lowMeaning: '大盘驱动——纯Beta', story: '🔍 一只股票每天的波动中，多少是因为大盘在动、多少是因为"它自己"的事？特质波动率剔除大盘影响——剩下的是"纯个股"噪音或信息。高特质波动=公司可能有"大事"在酝酿——并购/诉讼/产品发布。但学术上也发现"特质波动率之谜"——波动最高的一批股票反而收益最低。', signaldesc: '>2=极高特质事件驱动；0-2=偏高；<0=纯大盘驱动', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'XM_MOMENTUM_CRASH', level: 'L3', nameCN: '动量崩溃风险', categoryCN: '跨市场', region: 'global', oneLine: '动量策略的"脆弱性"评分——"现在追涨会不会突然崩"', descriptionCN: '综合动量拥挤度+近期动量股波动率+宏观不确定性(VXO/信用利差)的动量崩溃概率(0-100)。>70=高崩溃风险(2009年3月=92、2020年11月=88)。<30=动量策略安全。学术经典(Daniel & Moskowitz 2016, Barroso & Santa-Clara 2015)：动量策略的负偏度来自"动量崩溃"——市场反弹时输家股暴涨。', highMeaning: '动量策略极度脆弱——可能突然反转', lowMeaning: '动量策略运行安全', story: '💥 动量策略的"阿喀琉斯之踵"——动量崩溃。2009年3月，过去一年涨最多的股票(输家)一个月暴涨50%，过去一年涨最好的股票(赢家)暴跌——过去亏最多的反而赚最多。动量崩溃风险告诉你："现在的市场环境适合追涨吗？"', signaldesc: '>70=高度崩溃风险(不追)；30-70=中等；<30=安全', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_research' },
    { factorId: 'XM_CURRENCY_HEDGE', level: 'L3', nameCN: '货币对冲效率', categoryCN: '跨市场', region: 'global', oneLine: '外币敞口可被对冲的比例——"你的海外收益有多少可以被锁定"', descriptionCN: '(可对冲外币敞口/总外币敞口)×对冲成本的归一化评分(0-100)。>60=大部分外币敞口可低成本对冲(汇率风险可控)。<30=外币敞口难以对冲(如新兴市场货币远期流动性差→汇率风险显著)。适用于有跨国业务的港股(港元挂钩美元)+美股跨国公司。', highMeaning: '外币敞口可有效对冲——汇率风险可控', lowMeaning: '外币敞口难对冲——汇率风险显著', story: '🌍 一家港股公司30%收入来自欧元区——欧元贬值10%→利润缩水3%。但如果你能在远期市场锁定欧元/港币汇率——风险就没了。货币对冲效率看的是："你的外币收入能不能被低成本对冲"——新兴市场货币(卢比/雷亚尔)远期流动性极差→对冲成本高→风险暴露大。', signaldesc: '>60=可有效对冲；30-60=部分；<30=难对冲', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'XM_FACTOR_TIMING', level: 'L3', nameCN: '因子择时', categoryCN: '跨市场', region: 'global', oneLine: '宏观经济周期→因子轮动的推荐评分——"现在该用哪个因子"', descriptionCN: '基于产出缺口+通胀趋势+信用利差+期限利差的周期定位(扩张/过热/滞胀/衰退)，推荐因子权重(0-100)。扩张期→动量+成长权重高，过热期→价值+质量，滞胀期→低波+质量，衰退期→防御+低波+高息。基础研究来自Fama-French+Asness+Ilmanen的文献。', highMeaning: '该因子在当前周期高度适配', lowMeaning: '该因子不适合当前宏观周期', story: '⏰ "什么因子现在最好用？"——因子择时回答这个终极问题。2020年疫情衰退→低波+质量(最佳)，2021年复苏→价值+小盘(最佳)，2022年滞胀→防御+大宗(最佳)。因子择时根据经济周期自动推荐当前最应该用的因子组合。', signaldesc: '>70=当前周期高度适配；40-70=可接受；<40=周期不适配', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },

    // ── 🔬 综合/学术因子 ⚡ (10) ──────────────────────────────────────
    { factorId: 'VOLATILITY_REGIME_ADV', level: 'L3', nameCN: '进阶波动率区间', categoryCN: '宏观', region: 'global', oneLine: 'HMM波动率区间的进阶版——增加VIX期货期限结构+波动率风险溢价', descriptionCN: '在HMM两状态基础上叠加VIX期货期限结构+VRP的3状态分类(低波/过渡/高波)，状态切换置信度>85%。低波状态→趋势策略(持有)，过渡状态→择时策略(分批)，高波状态→反转策略+波动率交易(抄底/对冲)。比基础版HMM多一个"过渡态"→减误判。', highMeaning: '高波状态确认——全力防御', lowMeaning: '低波状态确认——趋势持有', story: '🌡️ 基础版波动率区间有"误判"风险——有时候市场"半高不低"。进阶版增加VIX期货和VRP信息→3状态(低/中/高)→减少"中波动区间误判为高波动"的假信号。过渡态="市场在犹豫"→减仓但不全部清仓。', signaldesc: '低波=趋势持有；过渡=分批操作；高波=防御+逆向', colors: { greenMax: 40, yellowMax: 70, redMin: 71 }, direction: 'lowerBetter', source: 'factor_research' },
    { factorId: 'EARNINGS_MOVE', level: 'L3', nameCN: '财报波动预测', categoryCN: '事件', region: 'global', oneLine: '财报前后的预期波动幅度——"财报那天股价会跳几个标准差"', descriptionCN: '基于ATM跨式期权价格×(1+隐含相关性调整)的财报日预期波动%。>8%=市场定价了极高财报波动(可能有大意外→买跨式期权)。<3%=低预期波动(财报可能平淡)。领先指标：财报前的隐含波动上升往往"提前"定价了大部分财报效应。', highMeaning: '财报日高波动预期——跨式策略机会', lowMeaning: '财报日平淡——预期波动小', story: '📆 财报前一天期权市场定价的"预期跳动"是最诚实的数据——做市商用真金白银在赌"这一天会跳多少"。Earnings Move>8%=期权市场认为有大意外→买跨式(同时买Call+Put)可能比赌方向更划算。', signaldesc: '>8%=高波动预期(买跨式)；3-8%=正常；<3%=平淡', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'CONVERTIBLE_ARB', level: 'L3', nameCN: '可转债套利', categoryCN: '事件', region: 'global', oneLine: '(可转债价格-理论价值)/理论价值——"可转债定价错误"', descriptionCN: '(可转债市价-二叉树/BSM理论价值)/理论价值。<-5%=可转债显著低估(买入可转债→做空正股→赚定价修复)。>+5%=可转债高估(做空可转债→买入正股)。需考虑Delta/Gamma/信用利差。覆盖光大/中信/美银美林可转债数据。', highMeaning: '可转债低估——套利介入', lowMeaning: '可转债高估或无定价错误', story: '🔀 可转债=债券+股票看涨期权——定价涉及利率/波动率/信用/正股价格多重变量→很容易被"错误定价"。如果可转债市价低过理论价值5%+——买入可转债+卖空正股="锁定"那5%的利润。这是华尔街可转债套利部门的"面包和黄油"。', signaldesc: '<-5%=低估套利；-5%到5%=正常；>+5%=高估', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'STAT_ARB_RESIDUAL', level: 'L3', nameCN: '统计套利残差', categoryCN: '基本面', region: 'global', oneLine: '股价偏离"公允因子收益"的残差——"市场有没有错误定价它"', descriptionCN: '个股收益-Σ(因子暴露×因子收益)的残差Z-score。绝对值>2=个股显著偏离因子模型预测(市场可能错误定价→均值回归机会)。正残差→被高估(做空)，负残差→被低估(做多)。使用Fama-French五因子+动量模型。', highMeaning: '低残差——定价与因子模型一致', lowMeaning: '高残差绝对值——存在错误定价机会', story: '🔬 五因子模型说"你的收益应该=X"——但实际收益可能是Y。差值(X-Y)就是残差——市场在给你一个"因子模型无法解释的"价格。|残差|>2="市场错了"→有回归机会。这是量化对冲基金(如AQR/Renaissance)最核心的信号之一。', signaldesc: '|残差|<1=定价正常；1-2=轻度偏离；>2=显著错误定价', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'ROE_TREND', level: 'L3', nameCN: 'ROE趋势', categoryCN: '财务', region: 'global', oneLine: 'ROE 4季度移动均值同比——"盈利能力在改善还是恶化"', descriptionCN: 'TTM ROE 4季移动均值的同比变化率。>+20%=ROE急剧改善(基本面拐点→大行情可能启动)。<-20%=ROE急剧恶化(基本面崩坏)。趋势比水平值更有效——ROE从5%升到10%的股票跑赢了ROE一直是15%的股票(变化才是超额收益来源)。', highMeaning: 'ROE快速上升——基本面改善中', lowMeaning: 'ROE急剧下降——基本面恶化', story: '📈 一个ROE永远是15%的"好学生"——股价早就反映了。一个ROE从3%爬到12%的"进步生"——股价可能还没跟上！ROE趋势看的是"边际变化"——ROE在加速改善的公司是超额收益的富矿。"变好"比"一直好"更具爆发力。', signaldesc: '>20%=急剧改善(买入)；0-20%=小幅改善；<0=恶化', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'stock_diagnosis' },
    { factorId: 'SHORT_TERM_REVERSAL', level: 'L3', nameCN: '短期反转', categoryCN: '情绪', region: 'global', oneLine: '过去5日收益的短期反转效应——"跌了5天就该反弹"', descriptionCN: '-1×过去5日累积收益的Z-score。正值=过去5日跌了→短期反转(反弹)概率高。负值=过去5日涨了→短期回落风险。Jegadeesh(1990)和Lehmann(1990)经典发现：最极端的1周赢家下周跑输2%，最极端输家下周跑赢2%。流动性冲击和过度反应推动。', highMeaning: '短期超跌——反弹概率高', lowMeaning: '短期暴涨——回落风险', story: '🔄 "连跌5天"——第二天大概率是涨的。这不是玄学——Jegadeesh在1990年证明了短期反转效应(1周到1月)在统计上显著。为什么？过度反应+流动性冲击——有人被迫清仓→超跌→就会回弹。别忘了和趋势因子(6月-12月)是相反方向的——短期反转vs中期趋势=同一个市场的两个面。', signaldesc: '>2=强超跌反弹信号；0-2=轻度；<0=短期超买', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'GAP_FILL', level: 'L3', nameCN: '缺口回补', categoryCN: '情绪', region: 'global', oneLine: '价格缺口(跳空)的回补概率——"跳空的缺口会补上吗"', descriptionCN: '距上一个未回补缺口的天数和距离的综合评分。<3天+<2%距离=缺口回补概率极高(>70%的历史概率——技术分析经典"缺口总会被补")。>20天+>5%=回补概率低(可能是"突破缺口"——长期不回补)。突破缺口vs普通缺口的AI分类。', highMeaning: '缺口即将回补——均值回归机会', lowMeaning: '缺口远——可能为突破缺口', story: '🕳️ 技术分析最古老的"定律"——"缺口总会被补上"。虽然不完全对——但历史数据显示3天内+<2%距离的缺口有>70%概率在10个交易日内回补。突破缺口(伴随成交量暴增+新闻催化剂)的回补率则<30%。区分"普通缺口"和"突破缺口"是技术派的基本功。', signaldesc: '<3天+<2%=高回补概率；3-20天=中等；>20天=低', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'RETAIL_SENTIMENT', level: 'L3', nameCN: '散户情绪', categoryCN: '情绪', region: 'global', oneLine: 'Reddit/StockTwits帖子情感分析——"散户在兴奋吗"', descriptionCN: 'Reddit(WallStreetBets/Investing/Stocks)+StockTwits帖子NLP情感评分(-100到+100)。>60=散户极度看涨(逆向看跌——散户狂热往往是顶)。<-40=散户极度看空(逆向看涨)。学术研究(Antweiler & Frank 2004)确认：社交媒体情绪对短期股价有显著预测力(反方向)。', highMeaning: '散户极度看涨——逆向看跌', lowMeaning: '散户极度看空——逆向看涨', story: '🐦 WSB(华尔街赌场)上的帖子情绪是市场最"干净"的逆向指标。2021年1月GME狂热——Reddit帖子看涨度100——接下来3天暴跌80%。散户情绪是"乌合之众"的量化版——当所有人都认为"只涨不跌"时，往往是要跌的时候。', signaldesc: '>60=极度看涨(逆向)；20-60=偏乐观；<-40=极度看空(逆向)', colors: { greenMax: 35, yellowMax: 60, redMin: 61 }, direction: 'contextDependent', source: 'sentiment' },
    { factorId: 'NEWS_NLP', level: 'L3', nameCN: '新闻NLP情绪', categoryCN: '另类数据', region: 'global', oneLine: 'Bloomberg/Reuters头条NLP情绪——"新闻在说好还是坏"', descriptionCN: 'Bloomberg+Reuters+Benzinga+PR Newswire头条的FinBERT情感评分(-1到+1)。>+0.3=新闻面极度积极(利好)。<-0.3=新闻面极度消极(利空)。NLP模型(FinBERT)专为金融文本训练——比通用BERT在金融场景准确率+15%。信噪比随新闻发布时间衰减(>2小时的旧闻已部分定价)。', highMeaning: '新闻面极度积极——利好', lowMeaning: '新闻面极度消极——利空', story: '📰 FinBERT是专门训练在金融文本上的BERT变体——它知道"profit warning"(盈利预警)是负面的而"profit taking"(获利了结)不是(通用BERT会搞混)。新闻NLP评分告诉你："今天的头条在说什么"——这在财报季是最强的日内信号源。', signaldesc: '>0.3=极度积极；0-0.3=中性偏正；<-0.3=极度消极', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'sentiment' },
    { factorId: 'ESG_SCORE', level: 'L3', nameCN: 'ESG评分', categoryCN: '另类数据', region: 'global', oneLine: 'MSCI ESG评级+争议分数——"绿色溢价还是漂绿陷阱"', descriptionCN: 'MSCI ESG评级(CCC-AAA转0-100)+争议分数的加权评分。>70=ESG领先(机构ESG资金配置→估值溢价)。<30=ESG落后+有重大争议。学术发现：ESG改善才是超额收益来源。', highMeaning: 'ESG领先——机构绿色配置标的', lowMeaning: 'ESG落后——绿色资金回避', story: '🌱 ESG评分是真金白银的"资金流"。越来越多养老金要求ESG最低分数——不合格公司被剔除出投资池。ESG评分从B升到A的公司在评级调整前后有+2-4%超额收益。', signaldesc: '>70=领先(溢价)；40-70=中等；<30=落后', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },

    // ═══════════════════════════════════════════════════════════════════════
    // R194: 🇯🇵 日本+🇹🇼 台湾市场专属因子 (JP12 + TW7 = 19)
    // ═══════════════════════════════════════════════════════════════════════

    // ── 🇯🇵 日本市场 ⚡ (12) ──────────────────────────────────────────
    { factorId: 'JP_BOJ_ETF', level: 'L3', nameCN: '日银ETF买入', categoryCN: '日本', region: 'jp', oneLine: '日本央行(日银)ETF买入推定金额——"全球最大的ETF买家今天在买吗"', descriptionCN: '基于日银公开的市场操作数据+TOPIX型ETF成交量异常推定的日银ETF日买入额(亿日元)。正值=日银在托市(最强"国家队")。日银持有约37万亿日元ETF(日本股市最大单一持有者)，其买入行为对市场有巨大"锚定效应"。', highMeaning: '日银在买入——"国家队"托市', lowMeaning: '日银未买入——市场无政策支撑', story: '🏦 日本央行(日银)是全球最大的ETF买家——持有日本股市约7%的市值！每年固定买入约6万亿日元ETF。知道"日银今天买了吗"是你做日本市场的必修课——"和央行做对手盘"从来不是好主意。', signaldesc: '>500亿=日银大买(看涨)；100-500亿=正常；<100亿=日银休息', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'capital_flow' },
    { factorId: 'JP_CROSS_HOLDING', level: 'L3', nameCN: '交叉持股比例', categoryCN: '日本', region: 'jp', oneLine: '企业间相互持股/总市值——"日本特色的'稳定股东'有多重"', descriptionCN: '政策保有株式(企业间相互持股)占市值的比例Z-score。>1=高交叉持股(流通股少→股价易被操纵/低估→治理改革潜力大)。<−1=交叉持股已大幅削减(治理改善→"安倍/岸田改革"受益股)。日本独特的"系列"(Keiretsu)体系造就了全球最高的交叉持股比例。', highMeaning: '高交叉持股——治理改善空间大', lowMeaning: '交叉持股低——流通主导', story: '🏢 日本"系列"(三菱/三井/住友)——企业互相持有对方股票几百年不动。这些"稳定股东"占流通股30-50%→真正可交易的股票极少。东证交易所(JPX)正在强制企业削减交叉持股→被削减的股票流通盘暴增→巴菲特就爱投这种"治理改革"标的。', signaldesc: '>1=高交叉持股(治理改革机会)；0-1=中等；<0=低', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'stock_diagnosis' },
    { factorId: 'JP_MARCH_EFFECT', level: 'L3', nameCN: '3月效应', categoryCN: '日本', region: 'jp', oneLine: '日本股市3月财政年度末特有的"窗口装饰"效应——"机构在粉饰业绩吗"', descriptionCN: '距3月末(日本财政年度末)的交易日数+机构持仓调整强度的综合评分。越近3月末>60="窗口装饰"效应强(机构粉饰年报→推动持仓股上涨)。3月末后<30="4月反转"(粉饰结束→机构出货)。日本独特的财政年度(4月-3月)创造了全球独家的"3月效应"日历因子。', highMeaning: '3月末"粉饰行情"进行中', lowMeaning: '远离3月末——无窗口装饰', story: '📅 日本财政年度结束在3月——全世界独一份。3月前两周，所有日本机构(年金/保险/信托)疯狂买入自己的持仓股→"粉饰"年报业绩。3月效应是日本市场最可靠的季节性因子——"3月涨、4月跌"几乎每年重演。', signaldesc: '>60=粉饰行情强(跟)；30-60=中等；<30=无效应', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'JPY_CARRY_TRADE', level: 'L3', nameCN: '日元套息交易', categoryCN: '日本', region: 'jp', oneLine: '借日元买高息资产的套息交易活跃度——"全球carry trade的风向标"', descriptionCN: '(美联储利率-日银利率)×日元CFTC投机净空头的Z-score。>2=套息极度拥挤(日元空头持仓创新高→一旦反转日元暴涨→全球风险资产暴跌)。<−1=套息平仓中(日元回流→全球risk-off)。2024年8月日元套息平仓导致日经单日跌12%——史上最大。', highMeaning: '套息极度拥挤——逆转风险', lowMeaning: '套息平仓中——全球risk-off', story: '💹 借0.1%的日元→换成美元买5%的美债=白赚4.9%。这就是"日元套息交易"——全球最大的carry trade。问题是所有人都这样做→日元空头创历史新高→一旦日元升值→全部空头抢着平仓=日元暴涨=全球崩。2024年8月5日日经-12%就是这样来的。', signaldesc: '>2=极度拥挤(警惕逆转)；0-2=正常；<0=平仓中', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_research' },
    { factorId: 'JPX_400_SELECTION', level: 'L3', nameCN: 'JPX400选入预期', categoryCN: '日本', region: 'jp', oneLine: 'JPX日经400指数纳入概率——"日本版S&P500"的被动买入潮', descriptionCN: '基于ROE>8%+市值+流动性+治理评分的JPX400纳入概率(0-100)。>60=高概率纳入(被动资金将被迫买入→利好)。JPX400是日本版"S&P500"——只选400家ROE和治理最好的公司。纳入效应约+3-6%超额(日本GPIF等年金跟踪)。8月定期调整。', highMeaning: 'JPX400纳入概率高——被动买入在即', lowMeaning: '不符合JPX400标准', story: '📋 JPX日经400是"日本版S&P500"——只选最好的400家。日本GPIF(全球最大年金基金)和其他年金都跟踪它→纳入=被迫买入。JPX400是日本公司治理改革的"冠军榜"——被选入说明你的公司"真的在变好"。', signaldesc: '>60=高纳入概率；30-60=可能；<30=低', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'JP_TOPIX_SECTOR', level: 'L3', nameCN: 'TOPIX行业细分化', categoryCN: '日本', region: 'jp', oneLine: 'TOPIX 33行业的相对强弱——"日本版GICS轮动"', descriptionCN: 'TOPIX 33行业分类的3/6/12月加权动量排名。选前5行业=当前日本市场主线。日本行业细分比GICS更精细(汽车/电子/精密/化学/商社等独立)，捕捉日本特有的"行业轮动"——2023-2024商社/银行/汽车领涨。', highMeaning: '该行业是当前日本最强主线', lowMeaning: '该行业表现落后', story: '🏭 日本的"行业"和GICS不一样——丰田(汽车)、索尼(电子)、三菱商事(商社)、三菱UFJ(银行)各自代表完全不同的投资逻辑。TOPIX 33行业细分告诉你"现在日本在炒什么"——2023年是商社(巴菲特买了)+半导体，2024年是银行(利率上升)。', signaldesc: 'Top5=当前主线；6-15=追随；16+=落后', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'JP_FOREIGN_FLOW', level: 'L3', nameCN: '外国人买卖动向', categoryCN: '日本', region: 'jp', oneLine: '外国投资者周净买入/卖出——"老外在买日本吗"', descriptionCN: '东京证券交易所公布的"投资部门别买卖状况"中外国人周净买入额的Z-score。>2=外国人大量买入(看涨日本→日经上涨驱动力)。<-2=外国人大量卖出(撤离日本→日经承压)。外国人占东证成交额~60%——他们的方向决定日经方向。数据：东证每周四公布。', highMeaning: '外国人大量买入——日经上涨驱动力', lowMeaning: '外国人大量卖出——撤离日本', story: '🌏 日本股市60%的成交额来自外国人——日本散户和机构反而是"配角"。东证每周四公布"谁在买谁在卖"——外国人净买入连续>2周=日经大概率上涨。沃伦·巴菲特2020年开始"买爆日本"——外国人买入持续创新高→日经破1989年高点。', signaldesc: '>2=老外大买(跟)；0-2=温和；<-2=撤离', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'capital_flow' },
    { factorId: 'JP_DIVIDEND_SEASON', level: 'L3', nameCN: '分红季效应', categoryCN: '日本', region: 'jp', oneLine: '距3月/9月集中分红日的日历效应——"抢权行情"的日本版', descriptionCN: '距分红基准日(3月末/9月末)的交易日数×历史分红率预期。>60=抢权行情进行中(日本"配当取り"策略→投资者在分红前买入拿分红后卖出)。分红基准日+3天后="除权日"→股价自然回落(分红除权)→"分红抢劫"策略的alpha。', highMeaning: '分红抢权行情进行中', lowMeaning: '远离分红季——无日历效应', story: '💰 日本企业大多在3月和9月集中分红。日本独特的"配当取り"策略：分红基准日前2周买入→拿分红→除权后卖出。为什么这能赚钱？因为分红比除权落价更多(市场不完美)+日本的散户特别喜欢"拿分红"的感觉。', signaldesc: '>60=抢权行情(跟)；30-60=偏强；<30=无', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'JP_SHAREHOLDER_BENEFIT', level: 'L3', nameCN: '株主优待', categoryCN: '日本', region: 'jp', oneLine: '株主优待(股东福利)收益率——"持有一股能拿多少免费大米"', descriptionCN: '株主优待(公司给股东的实物/服务福利)的市场价值/股价。>3%=优待收益率极高(日本散户"优待族"会买入→需求支撑)。<0.5%=无优待。日本独有的"株主优待"文化(给股东发大米/机票/优惠券)，创造全球唯一的"优待需求"——散户为福利买股票。', highMeaning: '优待丰厚——"优待族"在买', lowMeaning: '无优待福利', story: '🎁 日本有个全球独一无二的现象——"株主优待"。持有一股全日空→每年免费机票，持有一股吉野家→免费牛丼。日本散户("优待族")会因为这些福利去买股票(即使股票本身不涨)。优待>3%="福利价值"超过股息→需求支撑超强。', signaldesc: '>3%=优待丰厚(需求支撑)；1-3%=有优待；<1%=无', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'JP_BANK_LENDING', level: 'L3', nameCN: '银行贷出态度', categoryCN: '日本', region: 'jp', oneLine: '日银短观(BOJ Tankan)银行贷出态度DI——"银行愿意借钱吗"', descriptionCN: '日银短观(季度调查)中"银行贷出态度判断DI"(扩散指数)的标准化值。正值>10=银行积极放贷(信用扩张→经济向好→利好银行/周期股)。负值<-10=银行惜贷(信用收缩→经济萎缩→防御模式)。日银短观是日本最重要的宏观经济调查——比GDP领先2-3个季度。', highMeaning: '银行积极放贷——信用扩张', lowMeaning: '银行惜贷——信用收缩', story: '🏦 日银短观(BOJ Tankan)是日本"最神"的宏观经济指标——每季度调查1万家企业。其中"银行贷出态度"告诉你"银行现在愿意借钱吗"——如果银行都不愿意借钱了→经济不可能好。日银短观领先GDP 6-9个月——是日本最好的"领先指标"之一。', signaldesc: '>10=信用扩张(利好周期)；0-10=温和；<0=收缩', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'JP_VALUE_TRAP', level: 'L3', nameCN: '价值陷阱检测', categoryCN: '日本', region: 'jp', oneLine: '日本低PB股的"陷阱概率"——"这个便宜货是真的便宜还是该便宜"', descriptionCN: '基于PB<0.8+ROE<5%+无回购+交叉持股高+行业衰退的"价值陷阱"概率(0-100)。>70=极可能为价值陷阱(低PB是因为公司"应该"便宜→买入是死钱)。<30=真低估(ROE尚可+治理改善+回购→"被错误定价的明珠")。日本市场PB<1的股票占50%+——一半以上是陷阱。', highMeaning: '极可能为价值陷阱——"便宜有便宜的道理"', lowMeaning: '真低估——"被市场错杀的明珠"', story: '⚠️ 日本企业有一半PB<1——"太便宜了！"——但你买了几年不涨。为什么？因为PB<1+ROE<5%=公司"应该"便宜——它不创造价值。价值陷阱检测告诉你：这个"便宜货"是真的"被错杀"(ROE>8%+有回购)→买，还是"活该便宜"(ROE<3%+不回购)→避开。', signaldesc: '<30=真低估(买)；30-70=中等；>70=陷阱(避开)', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'stock_diagnosis' },
    { factorId: 'JPY_SENSITIVITY', level: 'L3', nameCN: '日元敏感度', categoryCN: '日本', region: 'jp', oneLine: '企业利润对日元波动的敏感度——"日元涨1%你赚/亏多少"', descriptionCN: '海外收入占比×(1/美元日元变动)的弹性系数。>2=极度日元敏感(日元贬值1%→利润增2%→这些股票在"日元贬值趋势"中暴涨)。<-2=日元升值受益股(内需/进口型企业→日元升值利好)。日本出口企业(汽车/电子/机械)天然高敏感度——日元是日本股市最大的"宏观风向标"。', highMeaning: '极度日元敏感——贬值=暴涨', lowMeaning: '日元升值受益——内需型', story: '💴 日本股市最大的"开关"不是GDP——是日元。日元每贬值10%，丰田利润增厚约15%→股价涨。日元贬值=出口股涨(汽车/电子)，日元升值=内需股涨(零售/食品)。日元敏感度告诉你每只股票"跟日元的关系"——这是做日本股的第一课。', signaldesc: '>2=强贬值受益；0-2=中度；<0=升值受益', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },

    // ── 🇹🇼 台湾市场 ⚡ (7) ──────────────────────────────────────────
    { factorId: 'TW_MARGIN_BALANCE', level: 'L3', nameCN: '融资余额', categoryCN: '台湾', region: 'tw', oneLine: '台股融资(保证金)余额变化——"台湾散户借钱炒股了吗"', descriptionCN: '融资余额日环比变化率Z-score。>2=融资快速增加(散户"借钱炒股"→杠杆率上升→市场过热信号)。<-2=融资快速减少(散户割肉/断头→恐慌出清→底部信号)。台股融资余额与加权指数高度正相关(r>0.7)——散户杠杆是台股的"情绪温度计"。', highMeaning: '散户借钱炒股——杠杆过热', lowMeaning: '散户割肉——恐慌出清', story: '🔥 台股散户最爱"融资"(借钱买股票)——台股融资余额是世界最高的之一。融资余额暴增=散户在疯狂加杠杆→涨得过快→"一根大阴线"让融资户断头→强制平仓→加速下跌。这是台股最经典的"暴涨暴跌"模式——融资余额是预警信号。', signaldesc: '>2=杠杆过热(警惕)；0-2=偏热；<-1=出清(逆向)', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'capital_flow' },
    { factorId: 'TW_SHORT_RATIO', level: 'L3', nameCN: '融券余额比', categoryCN: '台湾', region: 'tw', oneLine: '融券余额/融资余额——"台股空头有多少"', descriptionCN: '(融券余额/融资余额)的Z-score。>2=融券占比异常高(大量散户做空→"散户做空"通常是反向信号→可能轧空)。<0.5=融券少(空头稀疏→也可能是市场"死气沉沉")。台股融券与融资是"双胞胎"——融资看多头热情，融券看空头情绪。', highMeaning: '散户大量做空——逆向看涨(可能轧空)', lowMeaning: '空头稀疏——正常', story: '🐻 台股"两大散户神器"——融资(借钱做多)、融券(借券做空)。融券/融资>2=太多人在做空→"人人看空"=逆向看涨。台湾散户最怕"被轧空"(融券回补推高股价)——融券高=轧空燃料充足。', signaldesc: '>2=高度轧空风险(逆向)；1-2=偏高；<1=正常', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'capital_flow' },
    { factorId: 'TW_FOREIGN_FLOW', level: 'L3', nameCN: '外资买卖超', categoryCN: '台湾', region: 'tw', oneLine: '外资在台股的净买超/卖超——"老外在买台湾吗"', descriptionCN: 'TWSE公布的外资及陆资日净买超额Z-score。>2=外资大买(看涨台股→外资占台股成交~30%→方向性力量)。<-2=外资大卖(撤离→台币通常同步贬值)。外资连续买超20天以上=台股牛市确认。外资对台积电等权值股的买卖影响尤其大。', highMeaning: '外资大买——台股上涨主推力', lowMeaning: '外资大卖——撤离台湾', story: '🌏 外资占台股成交约30%——且主要集中在前50大权值股(台积电/鸿海/联发科)。外资连续买超=台股"稳稳涨"，外资连续卖超=台股"压力山大"。外资+台币升值=台股最强组合——"外资买+汇率赚"。', signaldesc: '>2=外资大买(跟)；0-2=温和；<-2=撤离', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'capital_flow' },
    { factorId: 'TW_TSMC_LINKAGE', level: 'L3', nameCN: '台积电关联度', categoryCN: '台湾', region: 'tw', oneLine: '个股与台积电(2330)的收益相关性——"台积电涨你会跟着涨吗"', descriptionCN: '个股与台积电(2330)的60日滚动Beta。>1.5=高度跟随台积电("台积电影子股"→台积电涨你暴涨、台积电跌你暴跌)。<0.5=独立于台积电(有自己的α)。台积电占台股大盘权重~30%——"台股看台积"不是玩笑。台积电供应链(设备/材料/封测)Beta显著>1。', highMeaning: '与台积电高度联动——"台积电概念股"', lowMeaning: '独立于台积电——有独立α', story: '🔗 台积电(2330)占台股大盘30%——一只股票决定台股方向。但不同的台股跟台积电的"紧密度"天差地别：台积电供应商(弘塑/家登/闳康)Beta>1.5(台积电涨2%他们涨3%)，而食品/金融股Beta<0.3(几乎无关)。台积电关联度告诉你"台积电涨了你能分多少"。', signaldesc: '>1.5=高度关联(同涨同跌)；0.5-1.5=中等；<0.5=独立', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'TW_DIVIDEND_CHASE', level: 'L3', nameCN: '除权息行情', categoryCN: '台湾', region: 'tw', oneLine: '除权息日前的"抢权"+除权后的"填权"效应——"台湾特色的分红行情"', descriptionCN: '距除权息日的天数×预期股息率的综合评分。除权前2周=抢权行情(买→拿分红→除权日卖出)。除权后2周=填权行情(股价回升到除权前水平)。台股独特的"可扣抵税额"制度(2018年前)让散户疯狂抢权——即使取消后习惯仍在。6-8月是集中除权季。', highMeaning: '除权息行情进行中——抢权/填权', lowMeaning: '远离除权季——无日历效应', story: '💵 台股有全球最热的"分红文化"——每年6-8月是"除权息季"。散户疯狂"抢权"(除权日前买进拿分红)→除权后"填权"(股价慢慢涨回除权前水平)。如果公司能"填权"(除权后股价回到原来位置)="这个分红是真的赚"。填权率是台股投资最重要的隐性指标。', signaldesc: '>60=抢/填权行情强；30-60=正常；<30=弱', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'TW_FINANCING_OVERHEAT', level: 'L3', nameCN: '融资过热', categoryCN: '台湾', region: 'tw', oneLine: '融资余额占市值比+融资增速——"台版margin debt预警"', descriptionCN: '融资余额/总市值+融资余额环比增速的联合Z-score。>2=融资双重过热(高存量+高增速="最后的狂欢"→历史上有>80%概率在随后1-3个月出现>10%的回调)。<−1=融资极度冷却(散户完全死心→底部信号)。台股融资过热是最可靠的"逃顶"信号之一。', highMeaning: '融资极度过热——"逃顶"信号', lowMeaning: '融资冷却——散户心死(底部)', story: '🚨 台股最有名的"逃顶"信号——融资余额/市值创历史新高+融资增速也在飙。所有人都在借钱炒股→"已经没有新买家了"→顶部。2015年台股万点、2021年台股万八——融资过热都提前1周发出了明确信号。', signaldesc: '>2=极度过热(减仓)；0-2=偏热；<0=冷却(逆向)', colors: { greenMax: 35, yellowMax: 60, redMin: 61 }, direction: 'lowerBetter', source: 'capital_flow' },
    { factorId: 'TW_NT_DOLLAR', level: 'L3', nameCN: '台币汇率走势', categoryCN: '台湾', region: 'tw', oneLine: '台币(新台币)升贬值趋势——"热钱在流入还是流出台湾"', descriptionCN: 'USD/TWD 30日均线的Z-score。<-2=台币急剧升值(热钱流入→台股涨)。>2=台币急剧贬值(热钱流出→台股承压)。台币与台股正相关是亚洲最强的。', highMeaning: '台币急剧升值——热钱流入', lowMeaning: '台币急剧贬值——热钱流出', story: '💰 台币和台股是"连体婴"——外资买台股→换台币→升值→更多外资来买。台币贬值=外资卖台股。台币走势是台股方向的"先行指标"——汇率领先股市1-3天。', signaldesc: '<-2=强升(利好)；-2到2=正常；>2=急贬(利空)', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_research' },

    // ═══════════════════════════════════════════════════════════════════════
    // R195: 🇰🇷韩国+🇸🇬新加坡+🇦🇺澳洲市场因子 (KR6 + SG5 + AU5 = 16)
    // ═══════════════════════════════════════════════════════════════════════

    // ── 🇰🇷 韩国 ⚡ (6) ──────────────────────────────────────────────
    { factorId: 'KR_CHAEBOL_DISCOUNT', level: 'L3', nameCN: '财阀折扣', categoryCN: '韩国', region: 'kr', oneLine: '财阀集团(Chaebol)的"韩国折价"——"三星/现代/LG/SK到底便宜了多少"', descriptionCN: '财阀集团子公司PB中位数vs非财阀可比公司PB中位数的折价率Z-score。>1=财阀折价高(子公司被低估→治理改革可能释放价值)。韩国的"韩国折价(Korea Discount)"长期存在——财阀复杂的交叉持股和低分红导致估值折价20-40%。', highMeaning: '财阀折价高——治理改革价值释放空间大', lowMeaning: '财阀折价低——已部分修复', story: '🏢 韩国财阀(Chaebol)——三星/现代/LG/SK——控制了KOSPI 60%的市值。但它们复杂的交叉持股结构让外资头疼——"到底谁在控制这公司？"→估值折价20-40%(韩国折价)。如果财阀开始简化持股结构→折价修复→巨大的价值释放。', signaldesc: '>1=高折价(价值释放机会)；0-1=中等；<0=折价已修复', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'stock_diagnosis' },
    { factorId: 'KR_FOREIGN_OWNERSHIP', level: 'L3', nameCN: '外资持股比率', categoryCN: '韩国', region: 'kr', oneLine: '外资持股占总股本%的变化——"老外在买韩国吗"', descriptionCN: '外资持股比率月环比变化率的Z-score。>1.5=外资快速增持(看涨KOSPI→外资占KOSPI市值~33%)。<-1.5=外资减持(撤离韩国)。外资持股限制(个别公司上限)影响该因子解读——接近上限的公司外资增持空间有限。', highMeaning: '外资快速增持——KOSPI上涨驱动力', lowMeaning: '外资减持——撤离信号', story: '🌏 外资持有KOSPI市值约33%——是韩国股市最大的"玩家"。特别是三星电子外资持股>50%——三星的股价方向几乎由外资决定。外资持股比率变化领先KOSPI 1-2个月——连续增持=牛市在途。', signaldesc: '>1.5=外资增持(跟)；0-1.5=温和；<-1.5=减持', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'capital_flow' },
    { factorId: 'KR_SAMSUNG_LINKAGE', level: 'L3', nameCN: '三星关联度', categoryCN: '韩国', region: 'kr', oneLine: '个股与三星电子(005930)的收益相关性——"三星涨了你跟着涨吗"', descriptionCN: '个股与三星电子(005930.KS)60日滚动Beta。>1.5=三星供应链/财阀子公司(三星涨2%→你涨3%)。<0.5=独立于三星。三星占KOSPI权重~20%——"韩国股看三星"。三星子公司(三星SDI/三星电机/三星生命)与三星电子的Beta在0.6-1.2之间。', highMeaning: '与三星高度联动——"三星影子股"', lowMeaning: '独立于三星——有自己的α', story: '🔗 三星电子占KOSPI 20%——相当于"台积电+鸿海"的合体。但三星的触角远超台积电——三星SDI(电池)、三星电机(MLCC)、三星生命(保险)——这些"三星系"公司与三星电子的股价高度联动。三星关联度告诉你"韩国国民股涨了你会分多少"。', signaldesc: '>1.5=高度关联(三星影子)；0.5-1.5=中等；<0.5=独立', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'KR_OPTION_EXPIRY', level: 'L3', nameCN: '期权到期效应', categoryCN: '韩国', region: 'kr', oneLine: 'KOSPI200期权/期货同日到期(每月第二个周四)——"韩国版Triple Witching"', descriptionCN: '距KOSPI200期权+期货同日到期日(每月第二个周四)的天数×历史波动幅度的综合评分。>60=期权到期日临近(韩国"同时到期"制度→到期日14:50-15:00尾盘波动率放大2-4倍)。<20=远离到期日(稳定)。韩国是全球唯一股票期权+期货完全同日到期的市场。', highMeaning: '期权到期日临近——尾盘"波动炸弹"', lowMeaning: '远离到期日——环境稳定', story: '⏰ 韩国有个全球独一无二的制度——KOSPI200期权和期货在每月第二个周四"同时到期"(Triple Witching韩国版)。到期日最后10分钟(14:50-15:00)→"波动炸弹"——做市商疯狂对冲→尾盘暴涨暴跌。知道"今天是到期日吗"是交易韩国必须做的第一件事。', signaldesc: '>60=到期日临近(尾盘警惕)；30-60=接近；<30=安全', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_cloud' },
    { factorId: 'KR_KRW_SENSITIVITY', level: 'L3', nameCN: '韩元敏感度', categoryCN: '韩国', region: 'kr', oneLine: '企业利润对韩元(₩)波动的敏感度——"韩元贬值1%你赚/亏多少"', descriptionCN: '海外收入占比×USD/KRW弹性系数。>2=极度韩元敏感(贬值1%→利润增2%→出口股暴涨)。<-2=韩元升值受益(内需/进口股)。韩国出口(GDP 40%)+三星/现代/SK海力士全球收入>80%→韩元是KOSPI最大宏观变量——"韩元贬值=KOSPI涨"是最可靠的宏观交易。', highMeaning: '强贬值受益——出口股', lowMeaning: '升值受益——内需股', story: '💴 "韩元贬=KOSPI涨"——这是韩国市场最灵验的宏观规律。因为韩国GDP 40%依赖出口(全球最高之一)，三星/现代/SK的海外收入>80%。韩元每贬值10%，三星利润增厚约12%→KOSPI涨。韩元敏感度告诉你每只股票"吃韩元这碗饭有多深"。', signaldesc: '>2=强贬值受益；0-2=中度；<0=升值受益', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'KR_DIVIDEND_YIELD', level: 'L3', nameCN: '韩股股息特色', categoryCN: '韩国', region: 'kr', oneLine: '韩国独特的"低股息+低派息率"文化的股息评分——"这家公司终于开始分钱了"', descriptionCN: '股息率×(1+派息率季度环比)的综合评分。>60=股息率开始回升+派息率改善(公司"终于开始分钱"了→治理改善信号)。韩国派息率长期全球最低(~20% vs 美国~40%)——政府"企业价值提升计划"(Value-up)正推动企业提高分红→股息提升股有显著超额。', highMeaning: '股息在改善——"Value-up"受益股', lowMeaning: '典型韩国低息——分红吝啬', story: '💰 韩国企业是全球最"抠门"的——派息率只有20%(美国40%、日本30%)。但2024年韩国政府推出了"企业价值提升计划"——学日本的"治理改革"推高估值。股息率开始提升的公司是"Value-up"的最大受益者——"从一毛不拔到开始撒钱"的转变创造超额α。', signaldesc: '>60=股息改善(Value-up受益)；30-60=一般；<30=抠门', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'stock_diagnosis' },

    // ── 🇸🇬 新加坡 ⚡ (5) ──────────────────────────────────────────
    { factorId: 'SG_REIT_SPREAD', level: 'L3', nameCN: 'REIT息差', categoryCN: '新加坡', region: 'sg', oneLine: 'S-REIT预期收益率-10年SGS收益率——"REIT比国债多给多少"', descriptionCN: '(S-REIT预期分红率-10年新加坡政府债收益率)的Z-score。>2=REIT息差极高(REIT分红率远超国债→极具吸引力→资金流入REITs)。<0=息差消失(国债比REIT还划算→REITs承压)。新加坡是亚洲最大REIT市场(47只S-REIT，总市值>1000亿新元)——"新式收租"。', highMeaning: 'REIT息差极高——资金流入REITs', lowMeaning: '息差消失——REITs失去吸引力', story: '🏢 新加坡人爱"收租"——S-REIT(新加坡REIT)是亚洲最大、全球第三大REIT市场。47只REIT覆盖商场/写字楼/工业/数据中心。REIT息差=REIT分红率-国债收益率——息差>4%=REIT"太香了"(比国债多给4%)→资金涌→价格涨。', signaldesc: '>2=极高息差(买入REIT)；0-2=中等；<0=SGS更划算', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'SG_STI_WEIGHT', level: 'L3', nameCN: 'STI权重变动', categoryCN: '新加坡', region: 'sg', oneLine: '海峡时报指数(STI)季度权重调整预期——"30只蓝筹谁升谁降"', descriptionCN: 'STI 30只成分股权重变动预测评分(0-100)。>60=权重将提升(被动基金买入→利好)。<30=权重将降低(被动基金卖出)。STI由FTSE Russell按季度调整(3/6/9/12月)。三大银行(DBS/OCBC/UOB)合计占STI权重~40%——银行股变动主导STI。', highMeaning: '权重将提升——被动买入', lowMeaning: '权重将下降——被动卖出', story: '📐 海峡时报指数(STI)只有30只成分股——但三大银行(DBS/OCBC/UOB)就占了40%。STI权重变动=看这三家银行+几大REIT的权重变化。被纳入STI对新加坡公司是"晋升"——跟踪STI的机构必须配。', signaldesc: '>60=权重提升(被动买入)；30-60=稳定；<30=下降', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'SG_SGD_LINKAGE', level: 'L3', nameCN: '新元关联', categoryCN: '新加坡', region: 'sg', oneLine: '个股与新元汇率(USD/SGD)的关联——"新元强弱对你的影响"', descriptionCN: '个股收益与USD/SGD汇率变化的60日Beta。>1=新元贬值受益(出口/制造业→新加坡是贸易枢纽)。<-1=新元升值受益(进口/内需/REIT)。新加坡金管局(MAS)通过汇率(非利率)执行货币政策——新元是新加坡经济的"主开关"。', highMeaning: '新元贬值受益——出口型', lowMeaning: '新元升值受益——内需/REIT型', story: '🏦 新加坡金管局(MAS)不用利率——用汇率！新元NEER(名义有效汇率)是新加坡的"货币政策工具"。新元走强=MAS在收紧(对REIT不利)，新元走弱=MAS在宽松(利好出口/制造业)。新元关联告诉你股票跟"MAS的政策倾向"的关系。', signaldesc: '>1=贬值受益(出口)；-1到1=中性；<-1=升值受益(内需)', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'SG_DIVIDEND_CULTURE', level: 'L3', nameCN: '分红文化', categoryCN: '新加坡', region: 'sg', oneLine: '新加坡"强制分红"文化的股息评分——"这家公司今年会分多少"', descriptionCN: '预期股息率×连续分红年数×分红稳定性(标准差倒数)的评分(0-100)。>70=高分红+连续分红+分红稳定(新加坡"收息股"特征)。新加坡投资者极度偏好分红——REIT强制90%分红、银行分红率40-60%、蓝筹连续分红20年+比比皆是。', highMeaning: '高分文化——稳定且丰厚的分红', lowMeaning: '分红稀少——不符合新加坡文化', story: '💵 新加坡有全球最强的"分红文化"——REIT法律要求分90%利润，三大银行连续分红30年+，"新加坡人炒股就是为了拿分红"。分红文化评分>70="标准的SGX收息股"——稳定+连续+高息——本地机构和散户的"压箱底"选择。', signaldesc: '>70=高分文化(收息首选)；40-70=不错；<40=分红差', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'stock_diagnosis' },
    { factorId: 'SG_US_LISTED', level: 'L3', nameCN: '美股ADR关联', categoryCN: '新加坡', region: 'sg', oneLine: 'SGX股票vs其美股ADR的价差和Beta——"双重上市的套利机会"', descriptionCN: '(SGX价格-ADR价格×汇率)/SGX价格的Z-score+60日Beta综合评分。绝对值>2%=显著跨市场价差(套利机会)。新加坡有大量公司在港/美/新交叉上市——Sea Limited(SE/SGX)、Grab(GRAB/SGX)。价差>2%且Beta>0.8=可套利。', highMeaning: 'ADR折价——SGX便宜=买入机会', lowMeaning: 'ADR溢价——SGX贵=回避', story: '🌏 新加坡有很多"多国籍"公司——Sea Limited(冬海集团)在美股(SE)和SGX都上市。同一家公司的股票在不同市场交易→价格应该"一样的"→但有时价差>5%！SG-US ADR关联捕捉的就是这个"同一家公司不同价格"的套利窗口。', signaldesc: 'ADR折>2%=SGX便宜(买)；-2到2%=正常；>2%=贵', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'factor_research' },

    // ── 🇦🇺 澳洲 ⚡ (5) ──────────────────────────────────────────────
    { factorId: 'AU_COMMODITY_LINK', level: 'L3', nameCN: '大宗商品关联', categoryCN: '澳洲', region: 'au', oneLine: '个股与铁矿石/铜/金/煤/天然气价格的Beta——"澳洲股的'矿脉地图'"', descriptionCN: '个股收益与ASX资源指数+铁矿石+铜+金+煤+天然气的多变量Beta。>1.5=强资源股(BHP/RIO/FMG→铁矿石涨=A股涨)。<0.3=独立于资源(银行/零售/科技)。澳洲股市"资源权重"极高(ASX 200中矿业+能源占25%+市值)→商品是ASX的第一驱动力。', highMeaning: '强资源驱动——"跟着铁矿石走"', lowMeaning: '资源独立——非矿业股', story: '⛏️ 澳洲股市就是"矿"——ASX 200 25%+的市值是矿业和能源公司。铁矿石价格涨10%→BHP/RIO/FMG股价涨15-20%→ASX 200涨。大宗商品关联度告诉你"这只澳股跟铁矿石/铜/黄金的关系"——知道这个，就知道你的股票是靠"矿价"还是靠"内需"驱动。', signaldesc: '>1.5=强资源股(商品驱动)；0.5-1.5=部分关联；<0.5=独立', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'AU_FRANKING_CREDIT', level: 'L3', nameCN: 'Franking Credit', categoryCN: '澳洲', region: 'au', oneLine: '股息已缴税抵免(Franking Credit)比率——"澳洲分红最甜蜜的\'灵魂\'"', descriptionCN: 'Franking Credit(已缴公司税可抵免部分)/总股息。100%=完全Franking(公司已缴30%税→股东分红全额免税→澳洲退休基金最爱)。0%=无Franking(分红要全额缴个税→对高税率投资者不友好)。Franking Credit是澳洲股市独有的"税收优势"——退休基金只买Fully Franked股票。', highMeaning: '全额Franking——税收最优分红', lowMeaning: '无Franking——分红税收效率低', story: '🇦🇺 Franking Credit是澳洲股市的"独家秘籍"——全球独一无二的"已缴税抵免"制度。公司缴了30%的税→分红给股东时"附上"税单→股东可以抵自己的个税。100% Franking的分红对澳洲退休基金来说="免税收入"→他们只买Fully Franked的股票。', signaldesc: '100%=完全Franked(最优)；50-99%=部分；<50%=低', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'stock_diagnosis' },
    { factorId: 'AU_DIVIDEND_SEASON', level: 'L3', nameCN: '分红季效应', categoryCN: '澳洲', region: 'au', oneLine: '澳洲2月/8月集中分红季的"抢权+除权"日历效应', descriptionCN: '距2月/8月澳洲集中分红季的天数×历史分红率预期。>60=分红季抢权行情(澳洲退休基金在除权日前增持拿Franking Credit→除权后减持)。澳洲企业90%集中在2月和8月分红——创造了一年中两个"抢权窗口"——这是ASX最强的日历效应。', highMeaning: '分红抢权行情进行中', lowMeaning: '远离分红季——无日历效应', story: '📅 澳洲企业90%集中在2月和8月分红——一年两个"抢权季"。澳洲退休基金(Superannuation Fund)在除权日前买入→拿Franking Credit→除权后卖出。这个"Franking Credit套利"让澳洲的分红季成为全球最"热"的日历效应——2月和8月的ASX 200平均跑赢其他月份2-3%。', signaldesc: '>60=抢权行情(跟)；30-60=偏强；<30=无', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'AU_BANK_DIVIDEND', level: 'L3', nameCN: '银行高息', categoryCN: '澳洲', region: 'au', oneLine: '澳洲四大银行(CBA/NAB/WBC/ANZ)的股息吸引力——"澳洲人的\'国债替代品\'"', descriptionCN: '四大银行平均股息率/(10年澳洲国债收益率+银行CDS利差)的Z-score。>1.5=银行股息远超国债(澳洲人"买银行就当买国债"→资金流入银行股)。<-1=银行股息吸引力下降。澳洲四大银行占ASX 200约20%——"买银行=买澳洲"。', highMeaning: '银行股息极具吸引力——"银行=国债"买入', lowMeaning: '银行股息吸引力下降', story: '🏦 澳洲四大银行——CBA/NAB/Westpac/ANZ——占ASX 200 20%。澳洲散户说"买银行"几乎等于"买国债"——四大银行"太大不能倒"+分红率5-7%+Franking Credit=实际到手收益比国债高2-3%。银行股息吸引力>1.5=所有人都在"存银行"。', signaldesc: '>1.5=极高吸引力(买入银行)；0-1.5=合理；<0=国债更优', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'AU_AUD_SENSITIVITY', level: 'L3', nameCN: '澳元敏感度', categoryCN: '澳洲', region: 'au', oneLine: '企业利润对澳元(AUD)波动的敏感度——"澳元涨1%你赚/亏多少"', descriptionCN: '海外收入占比×AUDUSD弹性系数。>2=强澳元贬值受益(矿业/出口)。<-2=升值受益。澳元是"商品货币"——铁矿石涨→澳元涨→资源-汇率-利率三角关系。', highMeaning: '澳元贬值受益——出口/矿业', lowMeaning: '澳元升值受益——内需/进口', story: '💱 澳元是全球最"商品"的货币——铁矿石涨→澳元涨。但澳元涨对矿企不一定好。澳元敏感度拆解这个三角关系——"澳元涨了对这只股票到底是好还是坏"。', signaldesc: '>2=贬值受益(矿业出口)；0-2=中度；<0=升值受益', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },

    // ═══════════════════════════════════════════════════════════════════════
    // R196: 🇮🇳印度+🇪🇺欧洲市场因子 (IN5 + EU4 = 9) → 44专属因子终局
    // ═══════════════════════════════════════════════════════════════════════

    // ── 🇮🇳 印度 ⚡ (5) ──────────────────────────────────────────────
    { factorId: 'IN_FII_DII_FLOW', level: 'L3', nameCN: 'FII/DII资金流', categoryCN: '印度', region: 'in', oneLine: '外资(FII)vs本地机构(DII)的净买超额差值——"老外和本地人谁在买印度"', descriptionCN: '(FII净买入-DII净买入)的Z-score。>1.5=FII买超DII(外资压倒本地——"热钱"涌入→NIFTY涨)。<-1.5=DII买超FII(本地接盘——外资撤离时DII(印度共同基金/LIC/EPFO)往往是"托市力量")。印度独特的FII(外资机构投资者)vs DII(本地机构投资者)双轨资金流是NIFTY最强方向指标。', highMeaning: 'FII压倒DII——外资推动上涨', lowMeaning: 'DII托市——外资在撤', story: '🌏 印度股市有一个独特指标——"FII vs DII"。FII=外国组合投资者(外资热钱)，DII=本地共同基金+LIC(印度人寿)+EPFO。FII在疯狂买入=DII在卖→"外资推动"=NIFTY涨。FII撤离=DII在接盘→"本地人救市"=NIFTY稳。这个"内战"每天都在上演。', signaldesc: '>1.5=FII主导(跟外资)；-1.5到1.5=均衡；<-1.5=DII接盘', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'capital_flow' },
    { factorId: 'IN_MONSOON_EFFECT', level: 'L3', nameCN: '雨季效应', categoryCN: '印度', region: 'in', oneLine: '印度季风(Monsoon)降雨量偏离对农业/消费/通胀的季节性影响——"老天爷心情=印度GDP"', descriptionCN: 'IMD(印度气象局)季风降雨量偏离历史均值%×受影响板块加权。正值>10%=雨季充沛(农业繁荣→农村消费升→NIFTY消费/FMCG好)。负值<-10%=干旱风险(农业崩→通胀升→RBI加息→NIFTY跌)。印度是"季风经济"——GDP的15%仍直接依赖农业——季风是印度最重要的"宏观因子"。', highMeaning: '雨季充沛——农业+消费繁荣', lowMeaning: '干旱风险——通胀+加息', story: '🌧️ 印度是"季风经济"——季风降雨量直接影响15%的GDP(农业)+农村消费(占消费总量~50%)。季风好=农民有钱→买摩托车/肥皂/手机→NIFTY消费板块涨。季风差=农村需求崩→食品通胀→RBI加息→NIFTY跌。"看印度先看雨"——这是印度投资第一课。', signaldesc: '>10%=充沛(利好消费)；0-10%=正常；<0=不足', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'IN_MODI_POLICY', level: 'L3', nameCN: '莫迪政策', categoryCN: '印度', region: 'in', oneLine: '莫迪政府改革政策(税改/基建/私有化/数字印度)的"改革热度"指数——"改革在加速还是停滞"', descriptionCN: '基于预算案执行率+法案通过数+基建开工率+私有化进展的综合改革热度评分(0-100)。>70=改革加速(莫迪"汉办到"→利好基建/国有银行/制造业)。<30=改革停滞(政治僵局→风险回避)。莫迪是印度最"亲市场"的总理之一——"莫迪溢价"(Modi Premium)是印度估值的重要支撑。', highMeaning: '改革加速——"莫迪溢价"扩大', lowMeaning: '改革停滞——政治风险', story: '🏛️ 莫迪是印度自尼赫鲁以来最强总理——GST税改/废钞令/基础设施建设/数字印度/国有银行私有化——改革力度决定"莫迪溢价"。外国投资者买印度=买"莫迪改革"——如果改革停滞(NIFTY PE从25降到20)，如果改革加速(PE从25升到30+)。', signaldesc: '>70=改革加速(利好)；40-70=正常；<30=停滞', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'IN_RUPEE_HEDGE', level: 'L3', nameCN: '卢比对冲效率', categoryCN: '印度', region: 'in', oneLine: '外国投资者对冲印度卢比(INR)的成本和可行性——"你的印度收益有多少能拿回美元"', descriptionCN: 'USD/INR远期升贴水×NDF可交易性的综合评分(0-100)。>60=卢比可有效对冲(远期市场流动性好→对冲成本低→外国投资者安心持有印度资产)。<30=卢比对冲难/贵(NDF受限→卢比贬值直接侵蚀外国投资者收益)。卢比贬值是外资撤离印度的最大驱动力——"对冲成本"决定外资持有意愿。', highMeaning: '卢比对冲便宜——外资安心持有', lowMeaning: '卢比对冲贵——外资撤离风险', story: '💴 外国投资者买印度股票最大的恐惧不是股市跌——是卢比跌。印度股市涨了10%但如果卢比跌了8%→你只赚了2%。卢比对冲效率告诉你"你的印度收益有多少是拿得回来的"——对冲成本>5%/年=还不如不投。', signaldesc: '>60=对冲便利(外资友好)；30-60=可接受；<30=对冲困难', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'IN_PLEDGED_SHARES', level: 'L3', nameCN: '质押股份风险', categoryCN: '印度', region: 'in', oneLine: '大股东将股份质押(pledge)的比例——"印度企业家把股票当ATM了吗"', descriptionCN: '大股东质押股份/总持股的Z-score。>1.5=高质押(大股东"把股票当抵押品"→如果股价跌30%→强制平仓→暴跌循环)。<0.5=低质押(健康)。印度企业独特的"质押文化"——很多企业家把股票质押获得资金投入其他业务(而非卖股)→"质押炸弹"是印度中小盘最大的"黑天鹅"。', highMeaning: '低质押——大股东财务健康', lowMeaning: '高质押——"质押炸弹"风险', story: '💣 印度最臭名昭著的"质押炸弹"——Adani集团2023年危机就是因为高质押+做空报告→股价暴跌→追加抵押品→更暴跌→"死亡螺旋"。印度企业家的"质押文化"是把双刃剑——质押率>50%的公司="定时炸弹"。', signaldesc: '<0.5=安全；0.5-1.5=注意；>1.5=高风险', colors: { greenMax: 35, yellowMax: 60, redMin: 61 }, direction: 'lowerBetter', source: 'stock_diagnosis' },

    // ── 🇪🇺 欧洲 ⚡ (4) ──────────────────────────────────────────────
    { factorId: 'EU_STOXX_SECTOR', level: 'L3', nameCN: '欧洲行业细分化', categoryCN: '欧洲', region: 'eu', oneLine: 'STOXX 600 20行业相对强弱——"泛欧行业轮动地图"', descriptionCN: 'STOXX 600 Super-Sector 20行业3/6/12月加权动量排名。选Top3=当前欧洲主线。欧洲行业结构独特(奢侈品/汽车/制药/银行权重显著高于全球平均)→行业轮动比美国更"集中"。2023-2024奢侈品牌(LVMH/Hermès/L\'Oréal)+制药(Novo Nordisk/诺华)主导。', highMeaning: '该行业是当前欧洲最强主线', lowMeaning: '该行业表现落后', story: '🏰 欧洲的行业结构和美国完全不一样——奢侈品(LVMH/Hermès)、制药(Novo Nordisk/罗氏)、汽车(BMW/奔驰)、银行(汇丰/桑坦德)是"欧洲四大天王"。STOXX行业细分告诉你"现在欧洲在炒什么"——2023年是"减肥药"(Novo Nordisk一家独大)+奢侈品。', signaldesc: 'Top3=当前主线；4-10=追随；11+=落后', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'EU_EUR_SENSITIVITY', level: 'L3', nameCN: '欧元敏感度', categoryCN: '欧洲', region: 'eu', oneLine: '企业利润对欧元(EUR)波动的敏感度——"欧元跌1%你的欧洲出口股涨多少"', descriptionCN: '非欧元区收入占比×EURUSD弹性系数。>2=强欧元贬值受益(出口股——BMW/空客/西门子→欧元贬值=产品价格更便宜→出口增)。<-2=欧元升值受益(内需/进口/美国收入占比高的公司)。欧元区GDP 50%来自出口(全球最高之一)→"欧元贬=DAX/CAC涨"是最可靠的欧洲宏观交易。', highMeaning: '欧元贬值受益——出口驱动', lowMeaning: '欧元升值受益——内需/进口', story: '💶 欧洲是"出口大陆"——德国GDP 47%靠出口(BMW/奔驰/西门子/巴斯夫)。欧元每贬值10%，DAX成份股利润平均增厚12-15%。欧元敏感度告诉你每只欧洲股"吃汇率这碗饭有多深"——"欧元贬=买出口"是欧洲投资的不变公式。', signaldesc: '>2=强贬值受益(出口)；0-2=中度；<0=升值受益', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'EU_ESG_PREMIUM', level: 'L3', nameCN: 'ESG溢价', categoryCN: '欧洲', region: 'eu', oneLine: '欧洲高ESG评分股票vs低ESG的估值溢价——"绿色是欧洲的\'护身符\'"', descriptionCN: '(STOXX ESG Leaders PE - STOXX ESG Laggards PE)/STOXX 600 PE的Z-score。>1.5=ESG溢价极高(高ESG公司被"绿色资金"追捧→估值偏高→可能泡沫化)。<-1=ESG溢价消失(无绿色偏好→市场"忘了"ESG)。欧洲是ESG投资"发源地"(SFDR法规强制)→"绿色溢价"在欧洲最显著。', highMeaning: 'ESG溢价正常——绿色资金方向', lowMeaning: 'ESG溢价消失——ESG被市场遗忘', story: '🌿 欧洲是全球ESG投资的"创始地"——SFDR(可持续金融披露条例)要求所有基金明确自己的ESG分类。欧洲"绿色资金"规模>$5万亿——高ESG公司被"强制买入"→估值溢价5-15%。ESG溢价告诉你"绿色资金现在多积极"——溢价太高(>+1.5)="ESG泡沫"？溢价消失="ESG过气了"？', signaldesc: '>1.5=ESG高溢价(可能泡沫)；0-1.5=正常；<0=无溢价', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'EU_BREXIT_SHADOW', level: 'L3', nameCN: '脱欧阴影', categoryCN: '欧洲', region: 'eu', oneLine: '英国脱欧后英欧经济分化——"英国和欧盟在越走越远吗"', descriptionCN: 'UK vs EU的GDP增速差×FTSE/STOXX相对表现×监管差异。>60=UK跑赢，<30=UK跑输。', highMeaning: '英国跑赢欧盟——脱欧红利', lowMeaning: '英国跑输——脱欧代价', story: '🇬🇧 英国脱欧多年——影子还在。2023-2024 UK跑输(英镑危机+通胀)→脱欧后悔情绪在市场上定价。', signaldesc: '>60=UK跑赢；30-60=分化；<30=UK跑输', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },

    // ═══════════════════════════════════════════════════════════════════════
    // R198: 🛢️ 大宗商品因子第一批 — L1期限+L2库存+L6季节 (14因子)
    // ═══════════════════════════════════════════════════════════════════════

    // ── L1 期限结构 ⚡ (7) ────────────────────────────────────────────
    { factorId: 'CMD_ROLL_YIELD', level: 'L1', nameCN: '展期收益', categoryCN: '大宗商品', region: 'global', oneLine: '商品期货近月vs次近月的年化展期收益率——"持有这个商品是赚钱还是亏钱"', descriptionCN: '(近月合约价格-次近月合约价格)/次近月价格的年化率。>5%=Backwardation(现货溢价→做多=持有商品有正收益+展期收益→"多头赚钱")。<−5%=Contango(期货溢价→展期亏损→"多头在流血"≈年化亏5%+)。商品长期正收益的第一性原理——Erb & Harvey(2006)经典发现。', highMeaning: 'Backwardation——做多持有有正收益', lowMeaning: 'Contango——做多持有在亏展期费', story: '🔄 商品期货和股票不一样——持有商品期货需要"展期"(到期换月)。如果远月比近月贵(Contango)→每次展期你都在"亏钱"(买贵了)。反之后向(Backwardation)→每次展期你在"赚钱"(低价买入)。展期收益是商品长期收益的"发动机"——没有它，商品指数长期收益为负。', signaldesc: '>5%=强Backwardation(持有多头)；0-5%=弱；<−5%=强Contango(做空或回避)', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CMD_TERM_STRUCTURE', level: 'L1', nameCN: '期限结构斜率', categoryCN: '大宗商品', region: 'global', oneLine: '期货曲线从近月到远月的整体斜率——"供给紧缺还是过剩"', descriptionCN: '(近月-12月远月)/近月的标准化斜率。>0.3=极度Backwardation(供给紧缺——"现货就是比期货贵"→恐慌抢现货)。<−0.3=极度Contango(供给过剩——"仓库都堆满了"→做空信号)。斜率反映的是"有多少人愿意现在高价买现货"——斜率陡=现货抢购。Gorton, Hayashi & Rouwenhorst(2013)核心指标。', highMeaning: '陡峭Backwardation——供给极度紧缺', lowMeaning: '陡峭Contango——供给严重过剩', story: '📐 期货曲线是商品的"心电图"——曲线陡峭向下(Backwardation)=市场在喊"现货不够！"。原油Contango深度>−0.3=油罐都满了→价格得跌到有人愿意买为止。期限结构是商品供需最纯粹的量化表达。', signaldesc: '>0.3=极度紧缺(做多)；0-0.3=正常；<−0.3=严重过剩(做空)', colors: { greenMax: 45, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CMD_BASIS', level: 'L1', nameCN: '基差', categoryCN: '大宗商品', region: 'global', oneLine: '现货价格-近月期货价格的偏离——"现货市场比期货市场更聪明吗"', descriptionCN: '(现货价格-近月期货价格)/近月期货价格的Z-score。>2=现货远高于期货(基差走强→现货买家在抢购→"现货比期货聪明"→期货可能跟涨)。<−2=现货远低于期货(基差走弱→现货市场疲软)。基差=现货和期货的"投票结果"——谁领先谁？实证: 现货基差领先期货价格1-5天。', highMeaning: '现货大幅溢价——现货市场极度紧张', lowMeaning: '现货大幅折价——现货市场疲软', story: '🔍 现货vs期货——"谁更聪明"？如果现货突然比期货贵2%+——现货买家(炼油厂/矿商/贸易商)在用真金白银投票："我现在就要货！"这种"现货紧张"通常1-5天后会传导到期货价格。基差是商品短线交易的"秘密武器"。', signaldesc: '>2=现货溢价极强(期货将跟涨)；0-2=温和；<−2=现货疲软', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CMD_MOMENTUM_12M', level: 'L1', nameCN: '12月动量', categoryCN: '大宗商品', region: 'global', oneLine: '过去12个月(扣除最近1个月)的累积收益——"这个商品在走趋势吗"', descriptionCN: '过去12个月(扣除最近1月以滤除短期反转)累积收益的横截面Z-score。>1.5=强趋势(动量策略基石——Moskowitz, Ooi & Pedersen 2012证明商品12月动量Sharpe>1.0)。<−1.5=强下跌趋势。注：商品动量收益集中在上行周期(供给冲击驱动的暴涨)→负偏度风险。能源和金属板块动量效应最强。', highMeaning: '强上涨趋势——商品趋势跟踪信号', lowMeaning: '强下跌趋势——做空或回避', story: '🚀 商品是全球最适合"趋势跟踪"的资产——因为供给冲击(飓风/战争/矿难)造成的价格趋势通常持续12-18个月。Moskowitz et al.(2012)证明：只做"过去12个月涨最多的商品、做空跌最多的"——年化收益+10-15%。商品动量的"秘密"：趋势持续时间比股票长、比汇率更可靠。', signaldesc: '>1.5=强上涨趋势(做多)；0-1.5=温和；<−1.5=强下跌(做空)', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'CMD_MOMENTUM_1M', level: 'L1', nameCN: '1月反转', categoryCN: '大宗商品', region: 'global', oneLine: '过去1个月的极端收益的反转概率——"涨太快就该回调"', descriptionCN: '-1×过去1月累计收益的横截面Z-score。>2=过去1月暴跌(短期超卖→反转反弹概率高)。<−2=过去1月暴涨(短期超买→回调风险高)。Miffre & Rallis(2007)发现商品存在短期反转效应(1-4周)→与12月动量的"中期趋势"互补——"短反长趋"。', highMeaning: '短期超跌——反转反弹', lowMeaning: '短期暴涨——回调风险', story: '🔄 商品短期(1个月)和中期(12个月)是"反着走"的——上个月涨最多的商品这个月容易回调，上个月跌最多的容易反弹。为什么？商品供给短期"粘性"+需求冲击的过度反应→均值回归。短反+长趋=商品CTA的"两把刀"。', signaldesc: '>2=强超跌反弹信号；0-2=轻度；<−2=短期超买(回调)', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'CMD_VOLATILITY', level: 'L1', nameCN: '波幅率', categoryCN: '大宗商品', region: 'global', oneLine: '商品60日年化波动率的Z-score——"这个商品最近安静还是暴躁"', descriptionCN: '60日年化波动率在5年历史中的分位数。>90%分位=极度高波动(供给+需求双重不确定性→"商品在暴走"→风险溢价极高但回撤风险也大)。<30%分位=波动率压缩(商品"横盘整理"→即将突破→期权跨式策略机会)。商品波动率具有"聚集性"——高波后继续高波(与股票不同)。', highMeaning: '极度高波动——商品暴走', lowMeaning: '波动率压缩——即将突破', story: '🌪️ 商品波动率比股票更"暴脾气"——天然气可以一天涨20%，原油可以一天跌10%。高波=供给冲击(飓风/战争)+需求恐慌(衰退)。但商品波动率的"聚集效应"比股票强→高波会持续高波→"波动率交易"是商品CTA的核心利润来源。', signaldesc: '>90%分位=暴走(CTA做多波动率)；30-90%=正常；<30%=压缩(突破在即)', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'contextDependent', source: 'factor_cloud' },
    { factorId: 'CMD_SKEWNESS', level: 'L1', nameCN: '偏度', categoryCN: '大宗商品', region: 'global', oneLine: '商品收益分布的不对称性——"这个商品更喜欢暴涨还是暴跌"', descriptionCN: '60日日收益的偏度(skewness)系数。>0.5=正偏(暴涨概率>暴跌——"供应冲击"特征→农产品/天然气)。<−0.5=负偏(暴跌概率>暴涨——"需求冲击"特征→工业金属/原油在经济衰退期)。Fernandez-Perez et al.(2018)发现商品偏度可预测未来收益——正偏商品未来收益低(保险溢价已定价)。', highMeaning: '正偏(暴涨多)——供应冲击驱动的"彩票"', lowMeaning: '负偏(暴跌多)——需求冲击风险', story: '🎲 商品和股票的最大区别——股票暴跌多(负偏)，商品却常常暴涨(正偏)！因为供给冲击(飓风摧毁天然气平台→价格一天涨30%)。但学术发现：正偏商品=市场已经把"暴涨保险"定价了→长期预期收益更低。偏度告诉你："现在是在赌暴涨还是防暴跌"。', signaldesc: '>0.5=正偏(暴涨多~供给紧张)；-0.5到0.5=对称；<−0.5=负偏(暴跌风险)', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'lowerBetter', source: 'factor_research' },

    // ── L2 库存供给 ⚡ (5) ────────────────────────────────────────────
    { factorId: 'CMD_EIA_CRUDE', level: 'L2', nameCN: 'EIA原油库存', categoryCN: '大宗商品', region: 'global', oneLine: 'EIA周度原油库存变化vs市场预期——"原油圈的非农数据"', descriptionCN: '(EIA库存实际变化-分析师预期中值)/预期标准差。<-2=库存骤降远超预期(强做多信号→库存下降=需求强劲/供给不足→原油涨。历史胜率>70%)。>2=库存暴增(供给过剩→做空原油)。EIA报告周三22:30发布——原油市场"最重要的周度数据"。', highMeaning: '库存骤降远超预期——强做多', lowMeaning: '库存远超预期增加——做空', story: '🛢️ 每周三晚上EIA报告是全原油市场的"心跳时刻"——库存降了多少？比预期多还是少？这5分钟的波动经常比一周都大。EIA库存意外<-2标准差=主力在"抢油"→油价必涨。这是人类已经养成的习惯——我们只是量化了它。', signaldesc: '<-2=库存骤降(强做多)；-2到2=符合预期；>2=暴增(做空)', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_cloud' },
    { factorId: 'CMD_NATGAS_STORAGE', level: 'L2', nameCN: '天然气库存', categoryCN: '大宗商品', region: 'global', oneLine: 'EIA天然气周度库存vs5年均值——"这个冬天够不够烧"', descriptionCN: '(当前库存-5年同期均值)/5年标准差。<-2=库存极度不足(供给紧缺→天然气暴涨风险——"这个冬天冷吗"成为市场核心问题)。>2=库存极度充裕(供给过剩→天然气承压)。天然气是最"天气驱动"的商品——库存偏离是供暖季(11-3月)最强信号。', highMeaning: '库存极度不足——寒冬风险', lowMeaning: '库存极度充裕——过剩', story: '🔥 天然气是"天气商品"——库存不够+天气预报说冷=价格可以翻倍。2022年欧洲天然气危机=库存低+俄罗斯断供=价格涨10倍。NatGas库存偏离-2=你在赌"这个冬天会很冷"——历史上天然气库存不足时12月-2月平均涨+25%。', signaldesc: '<-2=库存极度不足(做多)；-2到2=正常；>2=充裕(做空)', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_cloud' },
    { factorId: 'CMD_LME_INVENTORY', level: 'L2', nameCN: 'LME铜库存', categoryCN: '大宗商品', region: 'global', oneLine: 'LME注册仓单+注销仓单的库存信号——"铜博士的脉搏"', descriptionCN: '(LME铜总库存-5年均值)/5年标准差+(注销仓单/总库存的Z-score)的联合评分。注销仓单>40%+库存低于均值=铜即将"出库"(需求强→价格涨→强做多)。铜是"经济学博士"——库存变化领先全球PMI 1-2个月。LME每日公布注册/注销仓单——"铜圈日报"。', highMeaning: '库存低+注销高——铜需求爆发', lowMeaning: '库存高+注销低——铜需求疲弱', story: '🔬 铜是全球经济的"心电图"——LME仓库里的铜被"注销"(预约提货)=工业在扩张。注销仓单>40%+库存低于5年均值="铜博士"说："经济在加速"。LME库存是铜价最强的"领先指标"——领先价格3-7天。', signaldesc: '注销>40%+低库存=强做多；正常=中性；高库存+低注销=疲弱', colors: { greenMax: 45, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CMD_GOLD_ETF', level: 'L2', nameCN: '黄金ETF持仓', categoryCN: '大宗商品', region: 'global', oneLine: 'GLD+IAU黄金ETF的持仓量变化——"散户和机构在买金吗"', descriptionCN: 'GLD+IAU周度持仓变化的Z-score。>2=大量资金涌入黄金ETF(恐慌/避险情绪→"恐荒指数"→黄金涨)。<-2=资金大量撤离(风险偏好回归→黄金冷落→黄金承压)。黄金ETF持仓与金价高度正相关(r>0.8)——"ETF在买=金价在涨"。配合CFTC COT使用：ETF看散户+机构，COT看投机者。', highMeaning: 'ETF持仓大幅增加——黄金需求强劲', lowMeaning: 'ETF持仓大幅减少——黄金冷落', story: '🥇 GLD是全球最大黄金ETF——持仓量=全球投资者"用脚投票"的黄金需求。每天新闻报"黄金ETF增持X吨"——我们把这个"新闻"变成量化因子。ETF持仓暴增2标准差+美联储降息预期=黄金牛市最强组合。', signaldesc: '>2=ETF大幅流入(看涨金价)；0-2=温和；<-2=大幅流出', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'capital_flow' },
    { factorId: 'CMD_BALANCE_SHEET', level: 'L2', nameCN: '供需平衡表', categoryCN: '大宗商品', region: 'global', oneLine: 'USDA/EIA/IEA月度供需平衡(产量-消费)的"缺口"——"这个世界缺不缺这个商品"', descriptionCN: '（全球产量-全球消费）/全球消费的Z-score。<-2=极度供不应求(消耗库存→价格必涨→最强基本面做多信号)。>2=极度供过于求(库存堆积→价格承压)。覆盖USDA(农产品)/EIA(能源)/IEA(能源)/世界金属统计局(金属)。月度更新——是商品基本面"最重"的指标。', highMeaning: '供应缺口大——供不应求', lowMeaning: '供应过剩——库存堆积', story: '⚖️ 商品基本面最"笨"也最"真"的指标——全世界生产了多少、消费了多少，差值就是"缺口"。缺口>2%=这个世界每天消耗的商品比生产的多了2%→只能从库存里拿→库存总会用完→价格必须涨到有人愿意少用为止。这是商品投资最接近"内在价值"的因子。', signaldesc: '<-2=严重短缺(强做多)；-2到2=均衡；>2=严重过剩', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_research' },

    // ── L6 季節期 ⚡ (2) ────────────────────────────────────────────
    { factorId: 'CMD_SEASONALITY', level: 'L3', nameCN: '商品季节性', categoryCN: '大宗商品', region: 'global', oneLine: '当前月份商品的历史涨跌概率——"天然气冬天涨、汽油夏天涨"', descriptionCN: '商品在当前月份的10/20年平均涨跌幅Z-score(覆盖24个主要商品)。>2=历史上这个月该商品总是涨(天然气1月+7%/汽油5月+5%/大豆6月+4%/黄金9月+3%/棉花3月、可可12月)。<−1=历史上总是跌。商品季节性由供需周期驱动——取暖季/出行季/种植季/收获季。', highMeaning: '本月历史季节性极强——做多', lowMeaning: '本月历史上表现差——回避', story: '📅 商品有"体质"——天然气冬天必涨(取暖)、汽油夏天必涨(自驾游)、大豆6月必涨(种植面积不确定)。这些季节性来自"地球绕太阳"——人类改变不了。>2标准差的季节性=你在利用"地球公转"赚钱。', signaldesc: '>2=强季节性(做多)；0-2=温和；<0=历史弱势', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },
    { factorId: 'CMD_GOLD_SUMMER', level: 'L3', nameCN: '黄金夏季效应', categoryCN: '大宗商品', region: 'global', oneLine: '黄金6-8月"夏季低迷"→9月"秋季觉醒"——"黄金最准的日历"', descriptionCN: '基于月份+印度排灯节+中国春节的黄金需求日历评分。>60=黄金需求旺季(印度婚庆+春节+圣诞→做多)。<30=夏季低迷(5-8月)。黄金70%需求来自珠宝和零售。', highMeaning: '黄金需求旺季——"秋季觉醒"', lowMeaning: '夏季低迷——横盘等风', story: '🌞 黄金有最"灵验"的日历——5-8月横盘，9月涨(排灯节+国庆+圣诞"三连击")。"5月卖金、9月买金"是黄金交易员公开的秘密。', signaldesc: '>60=旺季(做多)；30-60=过渡；<30=夏淡(等待)', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },

    // ═══════════════════════════════════════════════════════════════════════
    // R199: 🛢️ 大宗商品收关 — L3持仓COT+L4宏观驱动+L5价差 (12因子)
    // ═══════════════════════════════════════════════════════════════════════

    // ── L3 持仓COT ⚡ (5) ────────────────────────────────────────────
    { factorId: 'CMD_COT_COMMERCIAL', level: 'L3', nameCN: '商业净持仓', categoryCN: '大宗商品', region: 'global', oneLine: 'CFTC COT报告中商业对冲者的净多头寸——"生产者/消费者在用什么价格锁货"', descriptionCN: '(商业多头-商业空头)/总持仓的Z-score。>2=商业净多头极端(生产者和消费者都在做多对冲→他们预见价格上涨→跟"产业资本"站在一起)。<-2=商业净空头极端(产业在大量卖出远期→他们预见价格下跌)。CFTC每周公布——商业持仓是"最聪明"的——因为他们最了解供需。', highMeaning: '商业净多极端——产业在锁上涨风险', lowMeaning: '商业净空极端——产业在锁下跌风险', story: '🏭 CFTC COT报告的"灵魂"——商业持仓(BHP/嘉吉/Cargill/Exxon等生产者和消费者)。他们不做投机——他们在"对冲"。如果商业净多创新高→产业资本在用真金白银赌价格上涨。商业持仓="跟聪明钱站在一起"。', signaldesc: '>2=商业强烈看涨；0-2=偏多；<-2=商业看空', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'sentiment' },
    { factorId: 'CMD_COT_SPECULATOR', level: 'L3', nameCN: '投机净持仓', categoryCN: '大宗商品', region: 'global', oneLine: 'CFTC COT中Managed Money的净多——"对冲基金在赌什么方向"', descriptionCN: '(Managed Money多头-MM空头)/总持仓的Z-score。>2=投机净多极端(对冲基金/CTA集体做多→"拥挤交易"→往往是反向信号——"所有人都上车了"→该下车了)。<-2=投机净空极端(逆向看涨——"没人敢做多时才是底")。投机者是"动量追逐者"——极端时反而是反向指标。', highMeaning: '投机净空极端——逆向看涨', lowMeaning: '投机净多极端——"拥挤"→反向看跌', story: '🎰 对冲基金和CTA是COT中的"投机者"——他们追涨杀跌。当Managed Money净多创历史新高→"所有人都在做多"→"已经没人可买了"→顶。投机净多极端是商品最经典的反向指标——"和COT反着做"是很多CTA策略的核心。', signaldesc: '<-2=投机恐慌(逆向看涨)；-2到2=正常；>2=投机狂热(谨慎)', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'sentiment' },
    { factorId: 'CMD_COT_EXTREME', level: 'L3', nameCN: 'COT拥挤度', categoryCN: '大宗商品', region: 'global', oneLine: '商业vs投机持仓偏离历史均值的极端程度——"两拨人在打架吗"', descriptionCN: '(投机净多Z-商业净多Z)的差值——"多空对决"指数。>2=投机极度看多而商业极度看空(经典的"分歧"→商业vs投机的"大战"→通常商业赢→看空)。<-2=投机看空而商业看多(商业在"抄底"→通常商业赢→看涨)。Basu & Miffre(2013)发现持仓分歧>2σ时有显著预测力。', highMeaning: '商业看多+投机看空——产业"抄底"信号', lowMeaning: '投机看多+商业看空——市场"过热"', story: '⚔️ 商品市场每天都在上演"战争"——商业(生产者/消费者)vs投机者(对冲基金/CTA)。当投机极度看多而商业极度看空→"外行在追、内行在跑"→历史上内行赢多输少。COT拥挤度就是这场"战争"的实时记分牌。', signaldesc: '<-2=商业抄底(跟商业做多)；-2到2=均衡；>2=投机过热(小心)', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'sentiment' },
    { factorId: 'CMD_COT_CHANGE', level: 'L3', nameCN: 'COT持仓变动', categoryCN: '大宗商品', region: 'global', oneLine: 'CFTC投机净多周度变动——"对冲基金这周在买还是卖"', descriptionCN: '投机净多头寸的周环比变化率Z-score。>2=投机者本周大幅加仓(动量信号→"聪明钱在追"→短线跟)。<-2=投机大幅减仓(恐慌出逃→"聪明钱在跑")。持仓变动比持仓水平更"实时"——因为反映的是"这一周"的边际变化。', highMeaning: '投机大幅加仓——短期动量', lowMeaning: '投机大幅减仓——短期恐慌', story: '📊 COT每周公布——"上周五之前"的数据(有3天延迟)。但周环比变化告诉你"这一周对冲基金在干什么"——大幅加仓=他们在追涨(短线跟着做)，大幅减仓=他们在跑(你也该小心)。持仓变动是COT的"高频版"。', signaldesc: '>2=投机加仓(短线跟)；0-2=温和；<-2=减仓(警惕)', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'sentiment' },
    { factorId: 'CMD_OPEN_INTEREST', level: 'L3', nameCN: '总持仓变化', categoryCN: '大宗商品', region: 'global', oneLine: '期货总持仓(Open Interest)的周度变化——"钱在进场还是离场"', descriptionCN: 'OI周环比变化率的Z-score。>2=总持仓大幅增加(新资金进场——"赌场在扩容"→趋势可能强化)。<-2=总持仓大幅减少(资金离场——"赌场在缩容"→流动性枯竭→趋势可能反转)。OI与价格同向=趋势确认，OI与价格反向=趋势衰竭。', highMeaning: 'OI增加+价格上涨=趋势健康', lowMeaning: 'OI减少——资金离场', story: '🎲 Open Interest是所有期货合约的"口袋"——总共有多少张合约在外面。OI暴增+价格上涨=新钱在涌入做多→趋势"根基深厚"。OI暴跌=不管价格涨跌→钱在走→"人走茶凉"。OI是趋势的"作弊器"——OI验证趋势=真趋势，OI不支持=假趋势。', signaldesc: '>2=资金进场(趋势强化)；0-2=温和；<-2=资金离场', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'capital_flow' },

    // ── L4 宏观驱动 ⚡ (4) ────────────────────────────────────────────
    { factorId: 'CMD_DXY_LINKAGE', level: 'L3', nameCN: '美元关联', categoryCN: '大宗商品', region: 'global', oneLine: '各商品对美元指数(DXY)的敏感度——"美元涨1%这个商品跌多少"', descriptionCN: '商品收益对DXY日变化的60日Beta。Beta<-1=强美元负相关(典型商品→黄金=美元涨它就跌→"美元是商品的镜子")。Beta>0=脱钩(不寻常→可能该商品被其他因素驱动→独立行情)。美元是商品定价的"分母"——全球商品以美元计价→美元走强=商品变贵→需求降→商品跌。', highMeaning: '强美元负相关——"美元跌=商品涨"', lowMeaning: '脱钩——商品在走独立行情', story: '💵 商品以美元计价——美元涨=商品对全球买家变贵→需求降→价格跌。但每个商品对美元的敏感度不一样——黄金最敏感(Beta≈-1.2)，原油次之(-0.8)，农产品最低(-0.3→人总要吃饭)。DXY关联告诉你："美元今天涨了，这个商品应该跌多少"。', signaldesc: 'Beta<-1=强负相关(美元驱动)；-1到0=弱相关；>0=脱钩', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_research' },
    { factorId: 'CMD_REAL_RATE', level: 'L3', nameCN: '实际利率', categoryCN: '大宗商品', region: 'global', oneLine: '10年期TIPS(通胀保护国债)收益率——"黄金的真正对手"', descriptionCN: 'TIPS 10Y收益率的Z-score(取反→实际利率越低→商品越涨)。<-2=实际利率极低(黄金最强支撑→"钱不值钱→硬资产值钱")。>2=实际利率极高(黄金最大利空→"持有黄金的机会成本太高")。实际利率是黄金的"第一性原理"——95%的金价波动可由实际利率解释。', highMeaning: '实际利率极低——硬资产最强支撑', lowMeaning: '实际利率极高——持有商品成本高', story: '📉 黄金不付利息——如果持有国债(TIPS)给你2%的实际收益，黄金0%→你为什么要持有黄金？但当TIPS收益率降到-1%→"你持有国债还要倒贴1%"→黄金变得"免费"→买。实际利率是黄金(和所有零收益商品)的"终极驱动"。', signaldesc: '<-2=实际利率极低(强利好)；-2到2=中性；>2=利率极高(利空)', colors: { greenMax: 45, yellowMax: 65, redMin: 66 }, direction: 'lowerBetter', source: 'factor_research' },
    { factorId: 'CMD_INFLATION_BE', level: 'L3', nameCN: '通胀预期', categoryCN: '大宗商品', region: 'global', oneLine: '5年/10年盈亏平衡通胀率(BEIR)——"市场赌未来通胀有多高"', descriptionCN: '5Y5Y通胀互换利率的Z-score。>2=市场在定价高通胀(通胀恐慌→"钱要变毛了"→买商品对冲通胀→商品涨——黄金/原油/铜最强)。<-1=市场定价通缩(通缩风险→商品被抛售)。BEIR是"市场用真金白银赌的未来通胀"——比经济学家预测准得多。', highMeaning: '通胀预期飙升——商品对冲需求', lowMeaning: '通缩预期——商品被抛售', story: '🎈 通胀预期(BEIR)是市场"用钱投票"的未来通胀——经济学家可以胡说，但交易员用真金白银下注。BEIR>2.5%=市场在喊"通胀来了！"→商品是对冲通胀最好的工具→能源和黄金最先反应。"通胀交易"的最佳触发器。', signaldesc: '>2=高通胀预期(商品利好)；0-2=温和；<0=通缩', colors: { greenMax: 50, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },
    { factorId: 'CMD_GEOPOL_RISK', level: 'L3', nameCN: '地缘风险', categoryCN: '大宗商品', region: 'global', oneLine: 'GPR(地缘政治风险指数)——"世界哪个角落又出事了"', descriptionCN: 'Caldara & Iacoviello GPR指数的Z-score。>2=全球地缘风险飙升(战争/制裁/恐怖袭击→原油/黄金暴涨→"危机Alpha")。<-1=地缘平静(商品由供需驱动)。GPR对原油影响最大(战争中断供给)，黄金次之(避险)，工业金属再次(制裁)，农产品最弱(人总要吃)。', highMeaning: '地缘风险飙升——危机Alpha', lowMeaning: '地缘平静——供需驱动', story: '🌍 炮声一响，黄金万两；油管一断，原油暴涨。地缘风险指数(GPR)量化了"世界的不安程度"——俄乌战争2022年2月GPR爆表(>3σ)→原油3天涨20%→黄金涨10%。GPR是商品的"危机开关"——飙升时做多黄金=买"战争保险"。', signaldesc: '>2=地缘危机(黄金/原油利多)；0-2=偏高；<0=平静', colors: { greenMax: 45, yellowMax: 70, redMin: 71 }, direction: 'higherBetter', source: 'factor_research' },

    // ── L5 价差 ⚡ (3) ────────────────────────────────────────────────
    { factorId: 'CMD_GOLD_SILVER_RATIO', level: 'L3', nameCN: '金银比', categoryCN: '大宗商品', region: 'global', oneLine: '金价/银价的Z-score——"白银是黄金的'杠杆版'还是'折价版'"', descriptionCN: '(金价/银价)偏离5年均值的Z-score。>2=金银比极高(>90→极度恐慌——黄金避险+白银工业属性被抛→往往是底部信号→买白银)。<-2=金银比极低(<60→极度贪婪——白银追赶黄金→风险偏好极高→黄金可能被低估)。金银比是"恐惧与贪婪"在贵金属上的最纯粹表达。', highMeaning: '金银比极高——黄金避险→逆向买白银', lowMeaning: '金银比极低——风险偏好极高→白银狂欢', story: '⚖️ 黄金是"恐惧"、白银是"憧憬"。金银比>90=世界很恐惧(黄金被疯抢、白银被抛弃)→但这种极端往往预示"恐惧到顶"——接下来白银会追赶黄金。金银比<60=世界太乐观(白银被当成"高科技金属"疯炒)→黄金可能被冷落→"黄金该补涨了"。', signaldesc: '>2=极度恐慌(逆向买入白银)；-2到2=均衡；<-2=极度贪婪', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'CMD_GOLD_OIL_RATIO', level: 'L3', nameCN: '金油比', categoryCN: '大宗商品', region: 'global', oneLine: '(金价/盎司)/(WTI/桶)的Z-score——"世界是在避险还是在消费"', descriptionCN: '(金价/油价)偏离5年均值的Z-score。>2=金油比极高(>30→极度避险——黄金涨+原油跌→"世界在储蓄而非消费"→经济衰退信号)。<-1=金油比极低(<15→风险偏好极高——原油追黄金→"世界在消费"→经济过热信号)。金油比是"黄金(恐惧)vs原油(增长)"的宏观多空对决。', highMeaning: '金油比极高——极度避险→衰退定价', lowMeaning: '金油比极低——风险偏好+经济增长', story: '🆚 金油比是"终极宏观对决"——黄金代表"恐惧"(避险资产)，原油代表"增长"(工业的血液)。金油比>30=黄金飞涨+原油躺平→市场在说"经济要衰退了"→买保险(黄金)、卖增长(原油)。金油比<15=原油狂飙+黄金冷落→市场在说"经济很热"。', signaldesc: '>2=极度避险(衰退信号)；0-2=中性；<−1=极度增长', colors: { greenMax: 40, yellowMax: 65, redMin: 66 }, direction: 'contextDependent', source: 'factor_research' },
    { factorId: 'CMD_CRACK_SPREAD', level: 'L3', nameCN: '裂解价差', categoryCN: '大宗商品', region: 'global', oneLine: '(汽油+馏分油-3×WTI)/3的Z-score——"炼油厂赚多少"', descriptionCN: '321裂解价差(1桶原油→2桶汽油+1桶馏分油的利润空间)的Z-score。>2=炼油利润极高(炼厂在印钞→利好炼油股/原油需求强)。<-1=炼油利润极低或亏损(炼厂减产→原油需求弱→利空原油)。裂解价差是"原油需求的体温计"——炼厂亏钱就会停产→原油需求消失。', highMeaning: '炼油利润丰厚——原油需求强劲', lowMeaning: '炼油亏损——原油需求将萎缩', story: '🏭 裂解价差(Crack Spread)是炼油厂的"利润表"——原油是"原材料"，汽油+馏分油是"产品"。价差>30美元/桶=炼油厂在"印钞"→他们会开足马力买原油→原油需求暴增→原油涨。价差<10美元=炼油厂在"亏钱"→他们会减产→原油需求消失→原油跌。', signaldesc: '>2=炼油丰厚利润(利好原油)；0-2=正常；<0=炼油亏损(利空)', colors: { greenMax: 55, yellowMax: 75, redMin: 76 }, direction: 'higherBetter', source: 'factor_cloud' },

  ].map(entry => [entry.factorId, entry] as const),
);

// ── R187: 4降级因子补丁 ────────────────────────────────────────────────────
// DISPOSITION_EFFECT, ANCHORING, EQUITY_MULTIPLIER, AH_PREMIUM_CHANGE
// 从R185 L1降级为R187 L2 (行为金融/高阶财务概念，新手难理解)

const R187_DEMOTE_PATCHES: Array<{ factorId: string; level: FactorLevel; eduStory: string; eduSignal: string }> = [
  {
    factorId: 'DISPOSITION_EFFECT',
    level: 'L2',
    eduStory: '🧠 你会卖掉赚了5%的股票而去补仓亏了30%的那只吗？这是人类最顽固的投资偏见——处置效应。行为金融学诺贝尔奖得主卡尼曼发现：人们倾向于过早卖出赚钱的股票(落袋为安)，过久持有亏损的股票(不愿承认错误)。专业选手反着做：止损果断，让利润奔跑。',
    eduSignal: '效应>70=多数人在卖盈持亏(底部未到)；30-70=正常行为；<30=市场趋于理性',
  },
  {
    factorId: 'ANCHORING',
    level: 'L2',
    eduStory: '⚓ 你买机票时看到"原价2000现价999"——2000这个数字就是一个锚。股票也是：52周高点、你的买入价、分析师目标价，全是心理锚点。锚定效应最危险之处：你会用过去的"锚"判断今天的价格——70块买的股票跌到50，你觉得"亏20不能卖"，但今天这只股票就值50。',
    eduSignal: '>80=股价极度接近历史锚点(追高风险)；50-80=接近锚点；<30=远离锚点(反转可能)',
  },
  {
    factorId: 'EQUITY_MULTIPLIER',
    level: 'L2',
    eduStory: '📐 ROE=20%看起来很棒！但如果你发现这家公司每1元净资产借了4元债来放大收益(权益乘数=5)——高ROE是"真本事"还是"杠杆堆出来的"？权益乘数帮你拆解ROE质量：乘数>5=高杠杆，一次市场波动可能让"高ROE"变成"负ROE"(资不抵债)。杜邦分析第一层分解。',
    eduSignal: '乘数<2=低杠杆稳健；2-4=正常；>5=高杠杆(ROE质量存疑)',
  },
  {
    factorId: 'AH_PREMIUM_CHANGE',
    level: 'L2',
    eduStory: '🔄 AH溢价本身是"静态快照"——A股比H股贵30%。但变化率才是交易信号：溢价从40%缩小到30%=H股在追赶涨得比A快(南下资金抄底) or A股在跌。你需要判断是哪种。只看溢价绝对值就像只看温度不看变冷还是变热——动态比静态多一层信息但更难解读。',
    eduSignal: '溢价收窄=H股相对走强(南下资金推动或A股调整)；溢价扩大=H股相对走弱',
  },
];

// Apply patches: update level + story + signaldesc for demoted factors
for (const patch of R187_DEMOTE_PATCHES) {
  const entry = FACTOR_I18N_REGISTRY.get(patch.factorId);
  if (entry) {
    entry.level = patch.level;
    entry.story = patch.eduStory;
    entry.signaldesc = patch.eduSignal;
  }
}

// ── Convenience Accessors ───────────────────────────────────────────────────

export function getFactorI18n(factorId: string): FactorI18nEntry | undefined {
  return FACTOR_I18N_REGISTRY.get(factorId);
}

/** Get Chinese name for a factor, fallback to factorId */
export function getFactorCNName(factorId: string): string {
  return FACTOR_I18N_REGISTRY.get(factorId)?.nameCN ?? factorId;
}

/** Get all factor IDs for a region */
export function getFactorsByRegion(region: 'global' | 'hk' | 'us' | 'crypto'): FactorI18nEntry[] {
  return [...FACTOR_I18N_REGISTRY.values()].filter(e => e.region === region);
}

/** Get all factors at a specific level */
export function getFactorsByLevel(level: FactorLevel): FactorI18nEntry[] {
  return [...FACTOR_I18N_REGISTRY.values()].filter(e => e.level === level);
}

/** Get level label in a given language */
export function getLevelLabel(level: FactorLevel, lang: string): string {
  return FACTOR_LEVEL_LABELS[level][lang] ?? FACTOR_LEVEL_LABELS[level]['en'];
}

/** Get all factor i18n entries */
export function getAllFactorI18n(): FactorI18nEntry[] {
  return [...FACTOR_I18N_REGISTRY.values()];
}

/** Get factor level distribution stats */
export function getFactorLevelStats(): Record<FactorLevel, number> {
  const stats: Record<FactorLevel, number> = { L1: 0, L2: 0, L3: 0 };
  for (const entry of FACTOR_I18N_REGISTRY.values()) {
    stats[entry.level]++;
  }
  return stats;
}

/** Get color for a score value based on factor's color thresholds */
export function getFactorColor(
  factorId: string,
  score: number,
): 'green' | 'yellow' | 'red' {
  const entry = FACTOR_I18N_REGISTRY.get(factorId);
  if (!entry) return 'yellow';
  if (score <= entry.colors.greenMax) return 'green';
  if (score <= entry.colors.yellowMax) return 'yellow';
  return 'red';
}

/** Get CSS color hex for a score */
export function getFactorColorHex(factorId: string, score: number): string {
  const color = getFactorColor(factorId, score);
  return { green: '#22c55e', yellow: '#eab308', red: '#ef4444' }[color];
}

export default {
  FACTOR_I18N_REGISTRY,
  getFactorI18n,
  getFactorCNName,
  getFactorsByRegion,
  getAllFactorI18n,
  getFactorColor,
  getFactorColorHex,
};
