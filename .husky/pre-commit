#!/bin/sh
# ?? DAWN WHALES Pre-commit Hook ?????????????????????????????????????????????

echo "?? Running pre-commit checks..."

# 1. TypeScript type check
echo "  [1/4] TypeScript..."
npx tsc --noEmit --skipLibCheck 2>&1 | head -5
if [ $? -ne 0 ]; then
  echo "? TypeScript errors found. Aborting commit."
  exit 1
fi

# 2. Lint staged files
echo "  [2/4] Lint..."
npx eslint --fix --quiet $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$') 2>&1 | tail -3

# 3. Run tests
echo "  [3/4] Tests..."
npm test 2>&1 | tail -1

# 4. i18n check
echo "  [4/4] i18n keys..."
node scripts/check-i18n.js 2>&1 || true

echo "? All checks passed!"
