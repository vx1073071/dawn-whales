  "PineScriptEditor.k0": "// 简单移动平均线\\nindicator(\"SMA\", overlay=true)\\nlength = input(20, \"长度\")\\nsma = ta.sma(close, length)\\nplot(sma, color=color.blue, linewidth=2)",
  "PineScriptEditor.k1": "// 指数移动平均线\\nindicator(\"EMA\", overlay=true)\\nlength = input(20, \"长度\")\\nema = ta.ema(close, length)\\nplot(ema, color=color.orange, linewidth=2)",
  "PineScriptEditor.k2": "// 相对强弱指标\\nindicator(\"RSI\")\\nlength = input(14, \"长度\")\\noverbought = input(70, \"超买\")\\noversold = input(30, \"超卖\")\\nrsi = ta.rsi(close, length)\\nplot(rsi, color=color.purple)\\nh1 = hline(overbought)\\nh2 = hline(oversold)\\nfill(h1, h2, color.new(color.red, 90))",
  "PineScriptEditor.k3": "// MACD 指标\\nindicator(\"MACD\")\\nfast = input(12)\\nslow = input(26)\\nsignal_len = input(9)\\n[macd, signal, hist] = ta.macd(close, fast, slow, signal_len)\\nplot(macd, color=color.blue)\\nplot(signal, color=color.orange)\\nplot(hist, style=plot.style_columns, color=hist > 0 ? color.green : color.red)",
  "PineScriptEditor.k4": "// 布林带\\nindicator(\"Bollinger\", overlay=true)\\nlength = input(20)\\nmult = input(2.0)\\nbasis = ta.sma(close, length)\\ndev = mult * ta.stdev(close, length)\\nupper = basis + dev\\nlower = basis - dev\\np1 = plot(basis, color=color.blue)\\np2 = plot(upper, color=color.gray)\\np3 = plot(lower, color=color.gray)\\nfill(p2, p3, color.new(color.blue, 90))",
  "PineScriptEditor.k5": "// 自定义指标\\nindicator(\"My Indicator\")\\n\\n// 在这里编写你的公式\\nma_fast = ta.sma(close, 5)\\nma_slow = ta.sma(close, 20)\\n\\nplot(ma_fast, color=color.green)\\nplot(ma_slow, color=color.red)\\n\\n// 金叉信号\\ncrossUp = ta.crossover(ma_fast, ma_slow)\\nplotshape(crossUp, style=shape.triangleup, color=color.green, location=location.belowbar)",
  "PineScriptEditor.k6": "公式名称 Formula name...",
