{
  "appId": "com.dawnwhales.app",
  "productName": "DAWN WHALES",
  "copyright": "Copyright © 2026 Dawn Whales",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json",
    "!node_modules/@esbuild",
    "!node_modules/@esbuild/**",
    "!node_modules/@rollup",
    "!node_modules/@rollup/**",
    "!node_modules/@playwright",
    "!node_modules/@playwright/**",
    "!node_modules/@storybook",
    "!node_modules/@storybook/**",
    "!node_modules/@opentelemetry",
    "!node_modules/@opentelemetry/**",
    "!node_modules/@babel",
    "!node_modules/@babel/**",
    "!node_modules/@testing-library",
    "!node_modules/@testing-library/**",
    "!node_modules/@sentry-internal",
    "!node_modules/@sentry-internal/**",
    "!node_modules/typescript",
    "!node_modules/typescript/**",
    "!node_modules/vite",
    "!node_modules/vite/**",
    "!node_modules/vitest",
    "!node_modules/vitest/**",
    "!node_modules/eslint*",
    "!node_modules/eslint*/**",
    "!node_modules/playwright*",
    "!node_modules/playwright*/**",
    "!node_modules/jsdom",
    "!node_modules/jsdom/**",
    "!node_modules/happy-dom",
    "!node_modules/happy-dom/**",
    "!node_modules/lighthouse",
    "!node_modules/lighthouse/**",
    "!node_modules/chromium-bidi",
    "!node_modules/chromium-bidi/**",
    "!node_modules/@paulirish",
    "!node_modules/@paulirish/**",
    "!node_modules/puppeteer-core",
    "!node_modules/puppeteer-core/**",
    "!node_modules/electron-builder",
    "!node_modules/electron-builder/**",
    "!node_modules/app-builder-bin",
    "!node_modules/app-builder-bin/**",
    "!node_modules/7zip-bin",
    "!node_modules/7zip-bin/**",
    "!node_modules/prettier",
    "!node_modules/prettier/**",
    "!node_modules/@electron-internal",
    "!node_modules/@electron-internal/**",
    "!node_modules/express",
    "!node_modules/express/**",
    "!node_modules/third-party-web",
    "!node_modules/third-party-web/**",
    "!node_modules/tailwindcss",
    "!node_modules/tailwindcss/**",
    "!node_modules/autoprefixer",
    "!node_modules/autoprefixer/**",
    "!node_modules/postcss",
    "!node_modules/postcss/**",
    "!node_modules/@electron-internal",
    "!node_modules/@electron-internal/**",
    "!src",
    "!tests",
    "!docs",
    "!**/*.map",
    "!**/*.ts",
    "!**/*.tsx",
    "!**/tsconfig.json",
    "!**/tsconfig*.json",
    "!**/*.md",
    "!**/LICENSE",
    "!**/package-lock.json",
    "!**/.bin"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**",
    "node_modules/electron-log/**"
  ],
  "compression": "maximum",
  "npmRebuild": false,
  "extraMetadata": {
    "main": "dist-electron/main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "uninstallDisplayName": "DAWN WHALES · 道鲸",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DAWN WHALES",
    "installerLanguages": [
      "zh_CN",
      "en_US",
      "ja_JP"
    ],
    "language": "2052"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.finance",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "identity": "${env.CSC_NAME}",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "background": "build/dmg-background.png"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icons",
    "category": "Finance",
    "desktop": {
      "Name": "DAWN WHALES",
      "Comment": "AI Quantitative Trading System",
      "Categories": "Finance;"
    }
  },
  "publish": {
    "provider": "github",
    "owner": "vx1073071",
    "repo": "dawn-whales",
    "releaseType": "release"
  }
}
