{
  "appId": "com.dawnwhales.app",
  "productName": "DAWN WHALES",
  "copyright": "Copyright © 2026 Dawn Whales",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "uninstallDisplayName": "DAWN WHALES",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DAWN WHALES"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.finance"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build/icon.png",
    "category": "Finance"
  },
  "publish": {
    "provider": "github",
    "owner": "dawn-whales",
    "repo": "dawn-whales"
  }
}
