{
  "name": "dawn-whales",
  "version": "1.12.0",
  "private": true,
  "description": "DAWN WHALES",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "dist:all": "vite build && npx tsx scripts/build-multi-platform.ts all",
    "release:check": "npx tsx scripts/v1-release-build.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --no-warnings --max-old-space-size=8192 node_modules/vitest/vitest.mjs run",
    "test:benchmark": "node scripts/benchmark.js",
    "test:market": "vitest run tests/market/",
    "test:account": "vitest run tests/account/",
    "test:broker": "vitest run tests/broker/",
    "test:strategy": "vitest run tests/strategy/",
    "test:risk": "vitest run tests/risk/",
    "test:executor": "vitest run tests/executor/",
    "test:automation": "vitest run tests/automation/",
    "test:ui-trading": "vitest run tests/ui-trading/",
    "test:ui-monitor": "vitest run tests/ui-monitor/",
    "test:integration": "vitest run tests/integration/",
    "test:performance": "vitest run tests/performance/",
    "test:all": "node --max-old-space-size=8192 node_modules/vitest/vitest.mjs run --reporter=verbose",
    "test:ci": "vitest run --reporter=junit --outputFile=./test-results/junit.xml",
    "test:ui-config": "vitest run tests/ui-config/",
    "dev:agent": "cross-env AGENT_MODE=headless vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "antd": "5.29.3",
    "better-sqlite3": "11.10.0",
    "dayjs": "1.11.21",
    "dompurify": "3.4.8",
    "echarts": "5.6.0",
    "echarts-for-react": "3.0.6",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "futu-api": "10.7.6708",
    "html2canvas": "^1.4.1",
    "i18next": "26.3.1",
    "lightweight-charts": "4.2.3",
    "proper-lockfile": "4.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.0.8",
    "winston": "3.19.0",
    "zod": "4.4.3",
    "zustand": "4.5.7"
  },
