{
  "name": "dawn-whales",
  "version": "0.12.0",
  "private": true,
  "description": "DAWN WHALES",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --no-warnings node_modules/vitest/vitest.mjs run",
    "test:market": "vitest run tests/market/",
    "test:account": "vitest run tests/account/",
    "test:broker": "vitest run tests/broker/",
    "test:strategy": "vitest run tests/strategy/",
    "test:risk": "vitest run tests/risk/",
    "test:executor": "vitest run tests/executor/",
    "test:automation": "vitest run tests/automation/",
    "test:ui-trading": "vitest run tests/ui-trading/",
    "test:ui-monitor": "vitest run tests/ui-monitor/",
    "test:integration": "vitest run tests/integration/",
    "test:performance": "vitest run tests/performance/",
    "test:all": "vitest run --reporter=verbose",
    "test:ci": "vitest run --reporter=junit --outputFile=./test-results/junit.xml",
    "test:ui-config": "vitest run tests/ui-config/",
    "dev:agent": "cross-env AGENT_MODE=headless vite"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "antd": "^5.18.0",
    "better-sqlite3": "^11.1.0",
    "dayjs": "^1.11.11",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "electron-log": "^5.1.5",
    "electron-updater": "^6.8.3",
    "futu-api": "^10.6.6608",
    "i18next": "^26.3.1",
    "jsdom": "^29.1.1",
    "lightweight-charts": "^4.1.3",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "winston": "^3.13.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.19",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "lighthouse": "^12.8.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.4",
    "typescript": "^5.5.2",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.1"
  }
}
