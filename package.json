{
  "name": "dawn-whales",
  "version": "0.7.0",
  "private": true,
  "description": "DAWN WHALES",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --no-warnings node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "antd": "^5.18.0",
    "better-sqlite3": "^11.1.0",
    "dayjs": "^1.11.11",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "electron-log": "^5.1.5",
    "electron-updater": "^6.2.1",
    "futu-api": "^10.6.6608",
    "i18next": "^26.3.1",
    "lightweight-charts": "^4.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "winston": "^3.13.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "fast-check": "^4.8.0",
    "jsdom": "^24.1.3",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.dawnwhales.app",
    "productName": "Dawn Whales",
    "copyright": "Copyright © 2026 Dawn Whales",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dawn Whales"
    },
    "mac": {
      "target": ["dmg"],
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "${productName}-${version}-linux-x64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vx1073071",
        "repo": "dawn-whales"
      }
    ]
  }
}