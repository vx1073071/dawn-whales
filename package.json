    "@typescript-eslint/parser": "8.61.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "10.4.20",
    "electron": "40.10.3",
    "electron-builder": "25.1.8",
    "eslint": "9.39.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "express": "^4.22.2",
    "fast-check": "^4.8.0",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
